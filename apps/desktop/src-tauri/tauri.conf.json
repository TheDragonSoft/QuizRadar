{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "QuizRadar",
  "version": "5.0.0-alpha.1",
  "identifier": "com.quizradar.app",
  "build": {
    "beforeDevCommand": {
      "script": "pnpm dev",
      "cwd": "../../web"
    },
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": {
      "script": "pnpm build",
      "cwd": "../../web"
    },
    "frontendDist": "../../web/dist"
  },
  "app": {
    "windows": [
      {
        "title": "QuizRadar",
        "width": 1420,
        "height": 880,
        "minWidth": 960,
        "minHeight": 620,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [],
      "pubkey": "",
      "windows": {
        "main": {}
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
