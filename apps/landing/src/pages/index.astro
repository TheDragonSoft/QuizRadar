<script>
  import {
    ANDROID_SCREENS,
    detectClientPlatform,
    isIosClient,
    PLATFORM_DOWNLOADS,
  } from "../lib/releaseData";

  // 1. OS-aware primary download CTA routing (routes iOS to Web Companion and desktop/Android to /download/#<os>)
  const ua = navigator.userAgent || "";
  const platform =
    (navigator as Navigator & { userAgentData?: { platform?: string } }).userAgentData?.platform ||
    navigator.platform ||
    "";
  const touchPoints = navigator.maxTouchPoints || 0;

  if (isIosClient(ua, platform, touchPoints)) {
    document.querySelectorAll<HTMLAnchorElement>("[data-dl-cta]").forEach((anchor) => {
      const webHref = anchor.dataset.webHref;
      if (webHref) anchor.href = webHref;
    });
    document.querySelectorAll<HTMLElement>("[data-dl-label]").forEach((span) => {
      span.textContent = "Open Web Companion (iOS)";
    });
    document.querySelectorAll<HTMLAnchorElement>("[data-secondary-cta]").forEach((anchor) => {
      const dlBase = anchor.dataset.downloadBase;
      if (dlBase) anchor.href = dlBase;
    });
    document.querySelectorAll<HTMLElement>("[data-secondary-label]").forEach((span) => {
      span.textContent = "Desktop & Android Installers";
    });
  } else {
    const os = detectClientPlatform(ua, platform);
    const target = PLATFORM_DOWNLOADS[os];
    document.querySelectorAll<HTMLAnchorElement>("[data-dl-cta]").forEach((anchor) => {
      const dlBase = anchor.dataset.downloadBase || "/download/";
      anchor.href = `${dlBase}#${os}`;
    });
    document.querySelectorAll<HTMLElement>("[data-dl-label]").forEach((span) => {
      span.textContent = target.label;
    });
  }

  // Reusable roving-tabindex tab controller
  function bindTabGroup(
    tabSelector: string,
    panelSelector: string,
    tabAttr: string,
    panelAttr: string,
    onActivate?: (id: string) => void,
  ) {
    const tabs = Array.from(document.querySelectorAll<HTMLButtonElement>(tabSelector));
    const panels = Array.from(document.querySelectorAll<HTMLElement>(panelSelector));
    if (tabs.length === 0) return;

    const activate = (id: string, focusTab = false) => {
      tabs.forEach((tab) => {
        const active = tab.dataset[tabAttr] === id;
        tab.classList.toggle("is-active", active);
        tab.setAttribute("aria-selected", active ? "true" : "false");
        tab.tabIndex = active ? 0 : -1;
        if (active && focusTab) tab.focus();
      });
      panels.forEach((panel) => {
        panel.hidden = panel.dataset[panelAttr] !== id;
      });
      onActivate?.(id);
    };

    tabs.forEach((tab, index) => {
      tab.addEventListener("click", () => {
        const id = tab.dataset[tabAttr];
        if (id) activate(id, false);
      });

      tab.addEventListener("keydown", (event) => {
        let nextIndex: number | null = null;
        if (event.key === "ArrowRight") nextIndex = (index + 1) % tabs.length;
        else if (event.key === "ArrowLeft") nextIndex = (index - 1 + tabs.length) % tabs.length;
        else if (event.key === "Home") nextIndex = 0;
        else if (event.key === "End") nextIndex = tabs.length - 1;
        if (nextIndex !== null) {
          event.preventDefault();
          const nextId = tabs[nextIndex]?.dataset[tabAttr];
          if (nextId) activate(nextId, true);
        }
      });
    });
  }

  // 2. Hero Interactive Timetable Resolver
  bindTabGroup("[data-resolver-tab]", "[data-resolver-panel]", "resolverTab", "resolverPanel");

  // 3. Real 2x Product Views Stage
  bindTabGroup("[data-view-tab]", "[data-view-panel]", "viewTab", "viewPanel");

  // 4. Android Glance Widget Switcher (4x2 vs 2x1)
  bindTabGroup("[data-widget-tab]", "[data-widget-panel]", "widgetTab", "widgetPanel");

  // 5. Android Screen Switcher with synced caption
  const captionEl = document.getElementById("android-active-caption");
  const androidCaptionMap = new Map(ANDROID_SCREENS.map((s) => [s.id, s.caption]));
  bindTabGroup("[data-android-tab]", "[data-android-panel]", "androidTab", "androidPanel", (id) => {
    if (captionEl && androidCaptionMap.has(id)) {
      captionEl.textContent = androidCaptionMap.get(id) ?? "";
    }
  });
</script>

