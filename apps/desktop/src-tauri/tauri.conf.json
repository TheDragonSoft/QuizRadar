{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "QuizRadar",
  "version": "5.4.0",
  "identifier": "com.quizradar.app",
  "build": {
    "beforeDevCommand": {
      "script": "pnpm dev",
      "cwd": "../../web"
    },
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": {
      "script": "pnpm build",
      "cwd": "../../web"
    },
    "frontendDist": "../../web/dist"
  },
  "app": {
    "windows": [
      {
        "title": "QuizRadar",
        "width": 1420,
        "height": 880,
        "minWidth": 960,
        "minHeight": 620,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https: asset:; font-src 'self' data:; connect-src 'self' https://generativelanguage.googleapis.com https://www.googleapis.com https://oauth2.googleapis.com https://accounts.google.com https://login.microsoftonline.com https://graph.microsoft.com ipc:",
      "devCsp": "default-src * 'unsafe-inline' 'unsafe-eval'; connect-src * ws: ipc:;"
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "quizradar"
        ]
      }
    },
    "updater": {
      "endpoints": [
        "https://github.com/TheDragonSoft/QuizRadar/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDYzNzhDMkE2Qjg0MjEwOTEKUldTUkVFSzRwc0o0WXovdmFkUW1KUk1iQ0l6STFqcWxtRCtaY3hFcmsrSzh3WjRUOVRSL09BQ2kK",
      "windows": {
        "main": {}
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "publisher": "TheDragonSoft",
    "copyright": "Copyright © 2026 TheDragonSoft — MIT licensed",
    "homepage": "https://github.com/TheDragonSoft/QuizRadar",
    "licenseFile": "../../../LICENSE",
    "category": "Education",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
