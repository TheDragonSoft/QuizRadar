# Line endings that must survive cross-platform checkouts.
# The lint gates (prettier) and the byte-compared generated fixtures
# (contract wire map) assume LF, so every text file checks out as LF
# regardless of the local core.autocrlf setting.
* text=auto eol=lf
gradlew text eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf
*.sh text eol=lf
tooling/git-hooks/* text eol=lf

# Binary assets stay binary (no diff noise)
*.png binary
*.jpg binary
*.gif binary
*.webp binary
*.ico binary
*.icns binary
*.keystore binary
*.jks binary
*.jar binary
*.so binary
*.dll binary
*.exe binary
*.wasm binary
*.ttf binary
*.woff binary
*.woff2 binary
