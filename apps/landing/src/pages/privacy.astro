---
import Layout from "../layouts/Layout.astro";
import { GITHUB_REPO_URL, withBase } from "../lib/releaseData";

const base = import.meta.env.BASE_URL;
const termsHref = withBase(base, "/terms/");
const homeHref = withBase(base, "/");

const scopes = [
  {
    provider: "Google",
    scope: "https://www.googleapis.com/auth/gmail.readonly",
    purpose:
      "Read-only scan of course announcement emails on your device to detect quiz, midterm, lab, and assignment deadlines. QuizRadar never sends, modifies, or deletes emails.",
  },
  {
    provider: "Google",
    scope: "https://www.googleapis.com/auth/classroom.courses.readonly",
    purpose:
      "Read-only list of your enrolled Google Classroom courses so announcements and deadlines match your weekly timetable.",
  },
  {
    provider: "Google",
    scope: "https://www.googleapis.com/auth/classroom.coursework.students",
    purpose: "Read-only fetch of upcoming Google Classroom assignments and due dates.",
  },
  {
    provider: "Google",
    scope: "https://www.googleapis.com/auth/calendar.events",
    purpose:
      "User-initiated push of confirmed upcoming exam dates from your local radar to your primary Google Calendar.",
  },
  {
    provider: "Google",
    scope: "https://www.googleapis.com/auth/drive.appdata",
    purpose:
      "Optional, user-initiated data-only JSON backup and restore inside your hidden Google Drive appDataFolder. QuizRadar cannot view any other Drive files.",
  },
  {
    provider: "Google",
    scope: "userinfo.email, userinfo.profile",
    purpose: "Display your signed-in account name and email in Settings.",
  },
  {
    provider: "Microsoft",
    scope: "openid, profile, email, User.Read, offline_access",
    purpose:
      "Sign in to your university or personal Microsoft account with PKCE and renew session tokens locally on your device.",
  },
  {
    provider: "Microsoft",
    scope: "Mail.Read, Calendars.Read",
    purpose:
      "Optional, incrementally consented read-only scan of Outlook/Teams course emails and calendar events on your device.",
  },
];
---

<Layout
  title="Privacy Policy — QuizRadar"
  description="QuizRadar's Privacy Policy, Google API Services User Data Policy Limited Use disclosure, OAuth scope justifications, token storage guarantees, and optional AI disclosures."
  canonicalPath="/privacy/"
  currentPage="privacy"
>
  <article class="legal-page">
    <div class="container legal-container">
      <header class="legal-header">
        <a href={homeHref} class="legal-back">← Back to QuizRadar</a>
        <h1>Privacy Policy</h1>
        <p class="legal-meta">
          <strong>Last Updated:</strong> November 2026 · <strong>Applies to:</strong> QuizRadar Desktop
          (Windows, macOS, Linux), Android, and Web Companion (PWA).
        </p>
      </header>

      <section class="legal-callout" aria-label="Google API Limited Use Disclosure">
        <h2>Google API Services User Data Policy — Limited Use Disclosure</h2>
        <p>
          QuizRadar's use and transfer to any other app of information received from Google APIs will
          adhere to the{" "}
          <a
            href="https://developers.google.com/terms/api-services-user-data-policy"
            target="_blank"
            rel="noopener noreferrer"
          >
            Google API Services User Data Policy
          </a>
          , including the Limited Use requirements.
        </p>
        <ul>
          <li>
            <strong>On-device processing only:</strong> Emails, Google Classroom coursework, and calendar
            items are fetched directly from Google APIs to your device and never stored in a QuizRadar
            server database.
          </li>
          <li>
            <strong>No advertising or data sales:</strong> QuizRadar never sells, rents, or uses Google
            user data for advertising, profiling, or marketing.
          </li>
          <li>
            <strong>No generalized AI/ML training:</strong> Google Workspace API data is never used to
            develop, improve, or train generalized AI or machine-learning models.
          </li>
          <li>
            <strong>No human access:</strong> No QuizRadar developer or third party can view your emails,
            grades, schedules, or OAuth tokens.
          </li>
        </ul>
      </section>

      <section class="legal-section">
        <h2>1. Local-First, Zero-Account Architecture</h2>
        <p>
          QuizRadar stores your courses, weekly timetable, parsed assessments, grades, attendance logs,
          study sessions, flashcards, and custom calendar events locally on your own device:
        </p>
        <ul>
          <li><strong>Desktop:</strong> Local SQLite database in your OS application-data directory.</li>
          <li>
            <strong>Android:</strong> Local SQLite database in app-private storage via native Rust UniFFI
            bindings.
          </li>
          <li>
            <strong>Web Companion (PWA):</strong> Local browser IndexedDB storage powered by the WebAssembly
            core engine.
          </li>
        </ul>
        <p>
          QuizRadar embeds zero analytics SDKs, zero tracking pixels, and zero ad networks. An optional
          user-initiated Desktop LAN HTTPS QR pairing session transfers data-only academic JSON directly
          over your local Wi-Fi using a pinned per-session self-signed TLS fingerprint and single-use
          token, then closes automatically after one sync or 5 minutes.
        </p>
      </section>

      <section class="legal-section">
        <h2>2. OAuth Scopes Requested &amp; Justification</h2>
        <p>
          All provider connections use PKCE (Proof Key for Code Exchange) with single-use random state
          validation. Every requested permission is documented in open source (
          <code>core/src/auth/providers.rs</code>):
        </p>
        <div class="scope-table-wrap">
          <table class="scope-table">
            <thead>
              <tr>
                <th>Provider</th>
                <th>Scope</th>
                <th>Exact Purpose</th>
              </tr>
            </thead>
            <tbody>
              {
                scopes.map((row) => (
                  <tr>
                    <td>
                      <strong>{row.provider}</strong>
                    </td>
                    <td>
                      <code>{row.scope}</code>
                    </td>
                    <td>{row.purpose}</td>
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>
      </section>

      <section class="legal-section">
        <h2>3. Token &amp; Credential Storage</h2>
        <p>
          Each device scans with its own OAuth tokens obtained directly from Google or Microsoft. Tokens
          never leave your device, never enter cloud backups, and never cross any relay:
        </p>
        <ul>
          <li>
            <strong>Desktop:</strong> Native OS Keyring (Windows Credential Manager, macOS Keychain, Linux
            Secret Service).
          </li>
          <li>
            <strong>Android:</strong> Hardware-backed <code>EncryptedSharedPreferences</code> via Android
            Keystore.
          </li>
          <li>
            <strong>Web Companion (PWA):</strong> Memory-only session tokens (~1 hour) cleared immediately
            when you close the tab.
          </li>
        </ul>
      </section>

      <section class="legal-section">
        <h2>4. Optional AI Features (BYOK Gemini &amp; Stateless Trial Relay)</h2>
        <p>
          AI features (multi-syllabus PDF/photo extraction, timetable photo import, study plan optimization,
          and practice quiz generation) are <strong>off by default</strong>, require explicit consent, and
          always provide honest local deterministic fallbacks.
        </p>
        <blockquote class="legal-quote">
          Your email announcements and timetable images are sent to Google's Gemini API when AI is used.
          On Google's free tier, Google may use that content to improve its products. Turn off to stay
          fully local.
        </blockquote>
        <ul>
          <li>
            <strong>BYOK Gemini:</strong> Provide your own free Gemini API key in Settings; requests go
            directly from your device to Google via the <code>x-goog-api-key</code> header.
          </li>
          <li>
            <strong>Opt-In Free Starter AI Relay (<code>https://trial-ai.quizradar.workers.dev</code>):</strong>{" "}
            A stateless Cloudflare Worker that allows first-run syllabus extraction without pasting an API
            key. Payloads pass strictly through volatile memory with zero logging or persistence, any{" "}
            <code>Authorization</code> header is rejected (HTTP 400), and daily rate limits store only
            auto-expiring SHA-256 hashes of a random anonymous install ID.
          </li>
        </ul>
      </section>

      <section class="legal-section">
        <h2>5. Cloud Backups &amp; Shareable Course Packs</h2>
        <ul>
          <li>
            <strong>Google Drive AppData:</strong> Backups strictly strip all OAuth tokens, passwords,
            session cookies, and API keys before upload.
          </li>
          <li>
            <strong>Shareable Course Packs (<code>qrpack1_</code>):</strong> Export only course slots,
            syllabus deadlines, grading weights, and study topics — never personal grades, attendance,
            focus history, or credentials.
          </li>
        </ul>
      </section>

      <section class="legal-section">
        <h2>6. Deleting Your Data &amp; Revoking Access</h2>
        <ul>
          <li>
            <strong>Erase Local Data:</strong> Open <strong>Settings → Data Management → Reset All Data</strong>{" "}
            to permanently wipe all local records and stored tokens.
          </li>
          <li>
            <strong>Revoke Google Permissions:</strong>{" "}
            <a
              href="https://myaccount.google.com/permissions"
              target="_blank"
              rel="noopener noreferrer"
            >
              https://myaccount.google.com/permissions
            </a>
          </li>
          <li>
            <strong>Revoke Microsoft Permissions:</strong>{" "}
            <a
              href="https://account.live.com/consent/Manage"
              target="_blank"
              rel="noopener noreferrer"
            >
              https://account.live.com/consent/Manage
            </a>
          </li>
          <li>
            <strong>Contact &amp; Source Audit:</strong> Inspect the full MIT source code or report a
            privacy/security issue via{" "}
            <a
              href={`${GITHUB_REPO_URL}/security/advisories/new`}
              target="_blank"
              rel="noopener noreferrer"
            >
              GitHub Security Advisories
            </a>
            . See also our <a href={termsHref}>Terms of Service</a>.
          </li>
        </ul>
      </section>
    </div>
  </article>
</Layout>

<style>
  .legal-page {
    padding-block: 48px 72px;
  }

  .legal-container {
    max-width: 860px;
    display: flex;
    flex-direction: column;
    gap: 28px;
  }

  .legal-back {
    display: inline-block;
    font-size: 0.84rem;
    font-weight: 600;
    color: var(--accent-ink);
    margin-block-end: 12px;
  }

  .legal-header h1 {
    font-size: clamp(1.9rem, 3.6vw, 2.5rem);
    letter-spacing: -0.03em;
    color: var(--text);
    margin-block-end: 8px;
  }

  .legal-meta {
    font-size: 0.9rem;
    color: var(--text-muted);
    line-height: 1.6;
  }

  .legal-callout {
    background-color: var(--surface-elevated);
    border: 1px solid var(--accent);
    border-radius: var(--radius-lg);
    padding: 22px 24px;
    box-shadow: var(--shadow-sm);
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .legal-callout h2 {
    font-size: 1.12rem;
    color: var(--text);
  }

  .legal-section {
    background-color: var(--surface);
    border: 1px solid var(--surface-border);
    border-radius: var(--radius-lg);
    padding: 22px 24px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .legal-section h2 {
    font-size: 1.16rem;
    color: var(--text);
  }

  .legal-page p,
  .legal-page li {
    font-size: 0.94rem;
    line-height: 1.68;
    color: var(--text-secondary);
  }

  .legal-page ul {
    padding-inline-start: 20px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .legal-page a {
    color: var(--accent-ink);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .legal-page code {
    font-family: var(--font-mono);
    font-size: 0.84rem;
    background-color: var(--page-subtle);
    border: 1px solid var(--surface-border);
    border-radius: 6px;
    padding: 1px 6px;
    word-break: break-word;
  }

  .legal-quote {
    margin: 4px 0;
    padding: 12px 16px;
    border-inline-start: 3px solid var(--accent);
    background-color: var(--page-subtle);
    border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
    font-style: italic;
    color: var(--text);
  }

  .scope-table-wrap {
    overflow-x: auto;
    border: 1px solid var(--surface-border);
    border-radius: var(--radius-md);
  }

  .scope-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.88rem;
  }

  .scope-table th,
  .scope-table td {
    text-align: left;
    vertical-align: top;
    padding: 10px 12px;
    border-block-end: 1px solid var(--surface-border);
    color: var(--text-secondary);
    line-height: 1.55;
  }

  .scope-table th {
    background-color: var(--page-subtle);
    color: var(--text);
    font-weight: 600;
  }

  .scope-table tbody tr:last-child td {
    border-block-end: none;
  }
</style>
