---
import Layout from "../layouts/Layout.astro";
import BrandIcon from "../components/BrandIcon.astro";
import CelestialSky from "../components/CelestialSky.astro";
import {
  APP_VERSION,
  CHECKSUMS_URL,
  GITHUB_RELEASES_LATEST,
  PLATFORM_DOWNLOADS,
  withBase,
} from "../lib/releaseData";

const base = import.meta.env.BASE_URL;
const webAppHref = withBase(base, "/app/");

const verifyPsSnippet = `Get-FileHash .\\QuizRadar_${APP_VERSION}_x64-setup.exe -Algorithm SHA256`;
const verifyShSnippet = `sha256sum --ignore-missing -c SHA256SUMS.txt`;
---

<Layout
  title="Download QuizRadar — Windows, macOS, Linux, Android & Web"
  description="Download signed QuizRadar installers for Windows, macOS, Linux, and Android, or launch the offline WebAssembly companion in your browser."
  canonicalPath="/download/"
  currentPage="download"
>
  <section class="dl-hero-wrap">
    <div class="container">
      <div class="dl-sky-banner">
        <CelestialSky showRadarArcs={true} />
        <div class="dl-sky-inner">
          <h1 class="dl-title">Download QuizRadar</h1>
          <p class="dl-lead">
            Every installer is compiled from public source by GitHub Actions and published with{" "}
            <a href={CHECKSUMS_URL} target="_blank" rel="noopener noreferrer" class="sky-link"
              ><code>SHA256SUMS.txt</code></a
            >{" "}
            on{" "}
            <a
              href={GITHUB_RELEASES_LATEST}
              target="_blank"
              rel="noopener noreferrer"
              class="sky-link">GitHub Releases</a
            >. Zero accounts, zero telemetry, MIT licensed.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="dl-cards-section">
    <div class="container dl-stack">
      <!-- Windows -->
      <article class="dl-card" data-platform-card="windows">
        <div class="dl-meta">
          <div class="dl-title-row">
            <div class="dl-os-icon">
              <BrandIcon name="windows" size={20} />
            </div>
            <h2>Windows</h2>
            <span class="os-badge">{PLATFORM_DOWNLOADS.windows.badge}</span>
            <span class="detected-pill" data-detected-badge="windows" hidden>Detected OS</span>
          </div>
          <p class="dl-req">{PLATFORM_DOWNLOADS.windows.requirements}</p>
          <p class="dl-note">{PLATFORM_DOWNLOADS.windows.notes}</p>
        </div>

        <div class="dl-actions">
          <a href={PLATFORM_DOWNLOADS.windows.primaryUrl} class="btn btn-primary">
            <BrandIcon name="download" size={16} />
            <span class="tabular">{PLATFORM_DOWNLOADS.windows.primaryArtifact}</span>
          </a>
          {
            PLATFORM_DOWNLOADS.windows.secondaryUrl && (
              <a href={PLATFORM_DOWNLOADS.windows.secondaryUrl} class="btn btn-secondary">
                <span>{PLATFORM_DOWNLOADS.windows.secondaryLabel}</span>
              </a>
            )
          }
        </div>
      </article>

      <!-- macOS -->
      <article class="dl-card" data-platform-card="mac">
        <div class="dl-meta">
          <div class="dl-title-row">
            <div class="dl-os-icon">
              <BrandIcon name="apple" size={20} />
            </div>
            <h2>macOS</h2>
            <span class="os-badge">{PLATFORM_DOWNLOADS.mac.badge}</span>
            <span class="detected-pill" data-detected-badge="mac" hidden>Detected OS</span>
          </div>
          <p class="dl-req">{PLATFORM_DOWNLOADS.mac.requirements}</p>
          <p class="dl-note">{PLATFORM_DOWNLOADS.mac.notes}</p>
        </div>

        <div class="dl-actions">
          <a href={PLATFORM_DOWNLOADS.mac.primaryUrl} class="btn btn-primary">
            <BrandIcon name="download" size={16} />
            <span class="tabular">{PLATFORM_DOWNLOADS.mac.primaryArtifact}</span>
          </a>
        </div>
      </article>

      <!-- Linux -->
      <article class="dl-card" data-platform-card="linux">
        <div class="dl-meta">
          <div class="dl-title-row">
            <div class="dl-os-icon">
              <BrandIcon name="linux" size={20} />
            </div>
            <h2>Linux</h2>
            <span class="os-badge">{PLATFORM_DOWNLOADS.linux.badge}</span>
            <span class="detected-pill" data-detected-badge="linux" hidden>Detected OS</span>
          </div>
          <p class="dl-req">{PLATFORM_DOWNLOADS.linux.requirements}</p>
          <p class="dl-note">{PLATFORM_DOWNLOADS.linux.notes}</p>
        </div>

        <div class="dl-actions">
          <a href={PLATFORM_DOWNLOADS.linux.primaryUrl} class="btn btn-primary">
            <BrandIcon name="download" size={16} />
            <span class="tabular">{PLATFORM_DOWNLOADS.linux.primaryArtifact}</span>
          </a>
          {
            PLATFORM_DOWNLOADS.linux.secondaryUrl && (
              <a href={PLATFORM_DOWNLOADS.linux.secondaryUrl} class="btn btn-secondary">
                <span>{PLATFORM_DOWNLOADS.linux.secondaryLabel}</span>
              </a>
            )
          }
        </div>
      </article>

      <!-- Android -->
      <article class="dl-card" data-platform-card="android">
        <div class="dl-meta">
          <div class="dl-title-row">
            <div class="dl-os-icon">
              <BrandIcon name="android" size={20} />
            </div>
            <h2>Android</h2>
            <span class="os-badge">{PLATFORM_DOWNLOADS.android.badge}</span>
            <span class="detected-pill" data-detected-badge="android" hidden>Detected OS</span>
          </div>
          <p class="dl-req">{PLATFORM_DOWNLOADS.android.requirements}</p>
          <p class="dl-note">
            {PLATFORM_DOWNLOADS.android.notes} Google PKCE sign-in works out of the box; for
            Microsoft Teams, add your Azure public client ID (redirect
            <code>com.quizradar.app://oauth/microsoft</code>) in <strong>Settings → Sources</strong>.
          </p>
        </div>

        <div class="dl-actions">
          <a href={PLATFORM_DOWNLOADS.android.primaryUrl} class="btn btn-primary">
            <BrandIcon name="download" size={16} />
            <span class="tabular">{PLATFORM_DOWNLOADS.android.primaryArtifact}</span>
          </a>
        </div>
      </article>

      <!-- Web Companion -->
      <article class="dl-card">
        <div class="dl-meta">
          <div class="dl-title-row">
            <div class="dl-os-icon">
              <BrandIcon name="globe" size={20} />
            </div>
            <h2>Web Companion (PWA)</h2>
            <span class="os-badge">WebAssembly + IndexedDB</span>
          </div>
          <p class="dl-req">Any modern desktop or mobile browser · Works offline after first load</p>
          <p class="dl-note">
            Runs the exact same <code>quizradar-core</code> engine compiled to WebAssembly. Uses
            ephemeral 1-hour Google Identity tokens in memory and standard <code>.ics</code> export.
          </p>
        </div>

        <div class="dl-actions">
          <a href={webAppHref} class="btn btn-secondary">
            <BrandIcon name="globe" size={16} />
            <span>Open Web Companion</span>
          </a>
        </div>
      </article>
    </div>
  </section>

  <!-- First-Time Installation & OS Security Guidance -->
  <section class="page-section install-guide-section">
    <div class="container">
      <div class="guide-card">
        <div class="guide-header">
          <div class="guide-icon">
            <BrandIcon name="shield" size={24} />
          </div>
          <div class="guide-header-copy">
            <h2>First-time installation &amp; security notes</h2>
            <p>
              QuizRadar is 100% free, MIT-licensed, and compiled from public source code by GitHub Actions CI.
              Because artifacts are released directly without proprietary commercial signing certificates, your OS may show a standard first-time security prompt.
            </p>
          </div>
        </div>

        <div class="guide-grid">
          <div class="guide-item">
            <div class="guide-os-row">
              <BrandIcon name="windows" size={17} />
              <h3>Windows Defender SmartScreen</h3>
            </div>
            <p>
              If a blue <em>“Windows protected your PC”</em> card appears: click <strong>More info</strong>, then click <strong>Run anyway</strong>. You can independently verify the hash of <code>QuizRadar_{APP_VERSION}_x64-setup.exe</code> against <code>SHA256SUMS.txt</code> below.
            </p>
          </div>

          <div class="guide-item">
            <div class="guide-os-row">
              <BrandIcon name="apple" size={17} />
              <h3>macOS Gatekeeper</h3>
            </div>
            <p>
              If macOS displays <em>“QuizRadar cannot be opened because Apple cannot check it”</em>: right-click <code>QuizRadar.app</code> in your Applications folder and click <strong>Open</strong>, or go to <strong>System Settings → Privacy &amp; Security</strong> and select <strong>Open Anyway</strong>.
            </p>
          </div>

          <div class="guide-item">
            <div class="guide-os-row">
              <BrandIcon name="android" size={17} />
              <h3>Android APK Sideload</h3>
            </div>
            <p>
              When downloading <code>QuizRadar-v{APP_VERSION}.apk</code>: tap <strong>Download anyway</strong>. When opening the installer, tap <strong>Settings</strong> and switch on <strong>Allow from this source</strong> to complete the install.
            </p>
          </div>

          <div class="guide-item">
            <div class="guide-os-row">
              <BrandIcon name="linux" size={17} />
              <h3>Linux AppImage &amp; Deb</h3>
            </div>
            <p>
              Make the AppImage executable: <code>chmod +x QuizRadar_{APP_VERSION}_amd64.AppImage &amp;&amp; ./QuizRadar_{APP_VERSION}_amd64.AppImage</code>. On Debian or Ubuntu, install with <code>sudo dpkg -i QuizRadar_{APP_VERSION}_amd64.deb</code>.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Checksum Verification -->
  <section class="page-section">
    <div class="container">
      <div class="verify-head">
        <h2>Verify your installer checksum</h2>
        <p>
          Compare your downloaded artifact’s SHA-256 hash against{" "}
          <a href={CHECKSUMS_URL} target="_blank" rel="noopener noreferrer" class="text-link"
            ><code>SHA256SUMS.txt</code></a
          >.
        </p>
      </div>

      <div class="verify-grid">
        <div class="cmd-card">
          <div class="cmd-head">
            <span>Windows PowerShell</span>
            <button type="button" class="copy-btn" data-copy-cmd={verifyPsSnippet}>
              <BrandIcon name="copy" size={13} />
              <span data-copy-status>Copy</span>
            </button>
          </div>
          <pre><code>{verifyPsSnippet}</code></pre>
        </div>

        <div class="cmd-card">
          <div class="cmd-head">
            <span>macOS / Linux</span>
            <button type="button" class="copy-btn" data-copy-cmd={verifyShSnippet}>
              <BrandIcon name="copy" size={13} />
              <span data-copy-status>Copy</span>
            </button>
          </div>
          <pre><code>{verifyShSnippet}</code></pre>
        </div>
      </div>
    </div>
  </section>
</Layout>

<script>
  import { detectClientPlatform } from "../lib/releaseData";

  const detected = detectClientPlatform(
    navigator.userAgent || "",
    (navigator as Navigator & { userAgentData?: { platform?: string } }).userAgentData?.platform ||
      navigator.platform ||
      "",
  );

  document.querySelectorAll<HTMLElement>("[data-detected-badge]").forEach((badge) => {
    badge.hidden = badge.dataset.detectedBadge !== detected;
  });

  document.querySelectorAll<HTMLElement>("[data-platform-card]").forEach((card) => {
    card.classList.toggle("is-detected", card.dataset.platformCard === detected);
  });

  document.querySelectorAll<HTMLButtonElement>("[data-copy-cmd]").forEach((btn) => {
    btn.addEventListener("click", async () => {
      const cmd = btn.dataset.copyCmd ?? "";
      const status = btn.querySelector<HTMLElement>("[data-copy-status]");
      try {
        await navigator.clipboard.writeText(cmd);
        if (status) {
          status.textContent = "Copied";
          setTimeout(() => {
            status.textContent = "Copy";
          }, 1800);
        }
      } catch {
        if (status) status.textContent = "Select";
      }
    });
  });
</script>

<style>
  .dl-hero-wrap {
    padding-block: 22px 32px;
  }

  .dl-sky-banner {
    position: relative;
    border-radius: 26px;
    overflow: hidden;
    padding: 44px 44px;
    color: #ffffff;
    box-shadow: var(--shadow-lg);
    border: 1px solid rgba(255, 255, 255, 0.14);
  }

  .dl-sky-inner {
    position: relative;
    z-index: 1;
    max-width: 740px;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 14px;
  }

  .dl-title {
    font-size: clamp(2.1rem, 4.2vw, 3.25rem);
    font-weight: 800;
    line-height: 1.08;
    color: #ffffff;
  }

  .dl-lead {
    font-size: 1rem;
    line-height: 1.62;
    color: rgba(241, 245, 249, 0.92);
    text-wrap: pretty;
  }

  .sky-link {
    color: #fde68a;
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .dl-cards-section {
    padding-block: 8px 64px;
  }

  .dl-stack {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .dl-card {
    background-color: var(--surface);
    border: 1px solid var(--surface-border);
    border-radius: var(--radius-lg);
    padding: 24px 26px;
    box-shadow: var(--shadow-sm);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 20px 32px;
  }

  .dl-card.is-detected {
    border-color: var(--accent);
    box-shadow: var(--shadow-md);
  }

  .dl-meta {
    max-width: 640px;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .dl-title-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
  }

  .dl-os-icon {
    width: 36px;
    height: 36px;
    border-radius: 10px;
    background-color: var(--page);
    border: 1px solid var(--surface-border);
    color: var(--text);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .dl-title-row h2 {
    font-size: 1.22rem;
    font-weight: 720;
    color: var(--text);
  }

  .os-badge {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 600;
    padding: 2px 8px;
    border-radius: 999px;
    background-color: var(--surface-elevated);
    border: 1px solid var(--surface-border);
    color: var(--text-muted);
  }

  .detected-pill {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 700;
    padding: 2px 9px;
    border-radius: 999px;
    background-color: var(--accent-soft);
    color: var(--accent-ink);
  }

  .dl-req {
    font-family: var(--font-mono);
    font-size: 0.76rem;
    color: var(--text-secondary);
  }

  .dl-note {
    font-size: 0.875rem;
    line-height: 1.56;
    color: var(--text-muted);
  }

  .dl-note code {
    font-size: 0.79rem;
    padding: 1px 5px;
    border-radius: 4px;
    background-color: var(--accent-soft);
    color: var(--accent-ink);
  }

  .dl-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
  }

  /* First-Time Installation & OS Security Guidance */
  .install-guide-section {
    padding-block: 28px 48px;
  }

  .guide-card {
    background-color: var(--surface);
    border: 1px solid var(--surface-border);
    border-radius: var(--radius-xl);
    padding: 32px 34px;
    box-shadow: var(--shadow-md);
    display: flex;
    flex-direction: column;
    gap: 26px;
  }

  .guide-header {
    display: flex;
    align-items: flex-start;
    gap: 16px;
  }

  .guide-icon {
    width: 44px;
    height: 44px;
    border-radius: 12px;
    background-color: var(--accent-soft);
    color: var(--accent-ink);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .guide-header-copy {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .guide-header-copy h2 {
    font-size: 1.35rem;
    font-weight: 750;
    color: var(--text);
  }

  .guide-header-copy p {
    font-size: 0.92rem;
    line-height: 1.58;
    color: var(--text-muted);
    max-width: 72ch;
  }

  .guide-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px 24px;
  }

  .guide-item {
    background-color: var(--page);
    border: 1px solid var(--surface-border);
    border-radius: var(--radius-md);
    padding: 18px 20px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .guide-os-row {
    display: flex;
    align-items: center;
    gap: 8px;
    color: var(--text);
  }

  .guide-os-row h3 {
    font-size: 0.98rem;
    font-weight: 700;
  }

  .guide-item p {
    font-size: 0.85rem;
    line-height: 1.55;
    color: var(--text-muted);
  }

  .guide-item code {
    font-size: 0.78rem;
    padding: 1px 5px;
    border-radius: 4px;
    background-color: var(--accent-soft);
    color: var(--accent-ink);
    word-break: break-word;
    overflow-wrap: anywhere;
  }

  .dl-note code {
    word-break: break-word;
    overflow-wrap: anywhere;
  }

  .verify-head {
    display: flex;
    flex-direction: column;
    gap: 6px;
    margin-block-end: 20px;
  }

  .verify-head h2 {
    font-size: 1.35rem;
    font-weight: 720;
    color: var(--text);
  }

  .verify-head p {
    font-size: 0.92rem;
    color: var(--text-muted);
  }

  .text-link {
    color: var(--accent-ink);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .verify-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
  }

  .cmd-card {
    background-color: var(--surface);
    border: 1px solid var(--surface-border);
    border-radius: 14px;
    overflow: hidden;
    box-shadow: var(--shadow-sm);
  }

  .cmd-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 9px 14px;
    background-color: var(--surface-elevated);
    border-block-end: 1px solid var(--surface-border);
    font-family: var(--font-mono);
    font-size: 0.73rem;
    font-weight: 600;
    color: var(--text-muted);
  }

  .copy-btn {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    padding: 4px 9px;
    border-radius: 7px;
    border: 1px solid var(--surface-border);
    background-color: var(--surface);
    color: var(--text-secondary);
    font-size: 0.72rem;
    font-weight: 600;
    transition-property: transform, color, border-color, background-color;
    transition-duration: 140ms;
    transition-timing-function: var(--ease-snappy);
  }

  .copy-btn:active {
    transform: scale(0.96);
  }

  .cmd-card pre {
    padding: 14px;
    font-size: 0.78rem;
    color: var(--text);
    overflow-x: auto;
  }

  @media (hover: hover) {
    .copy-btn:hover {
      border-color: var(--border-strong);
      color: var(--text);
    }
  }

  @media (max-width: 820px) {
    .dl-sky-banner {
      padding: 32px 22px;
      border-radius: 20px;
    }

    .verify-grid,
    .guide-grid {
      grid-template-columns: minmax(0, 1fr);
    }

    .guide-card {
      padding: 24px 18px;
    }
  }

  @media (max-width: 560px) {
    .guide-header {
      flex-direction: column;
      gap: 12px;
    }

    .dl-card {
      padding: 20px 18px;
    }

    .dl-actions,
    .dl-actions .btn {
      width: 100%;
    }
  }
</style>
