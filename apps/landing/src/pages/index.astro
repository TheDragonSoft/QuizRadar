---
import Layout from "../layouts/Layout.astro";
import BrandIcon from "../components/BrandIcon.astro";
import CelestialSky from "../components/CelestialSky.astro";
import {
  ANDROID_SCREENS,
  APP_VERSION,
  FAQ_ITEMS,
  GITHUB_REPO_URL,
  INGESTION_SOURCES,
  PLATFORM_DOWNLOADS,
  PRODUCT_VIEWS,
  RESOLVER_SCENARIOS,
  SUITE_FEATURES,
  withBase,
} from "../lib/releaseData";

const base = import.meta.env.BASE_URL;
const downloadHref = withBase(base, "/download/");
const webAppHref = withBase(base, "/app/");

const inputSources = INGESTION_SOURCES.filter((s) => s.direction === "input");
const outputSources = INGESTION_SOURCES.filter((s) => s.direction === "output");

function splitHighlight(text: string, highlight: string) {
  const idx = text.indexOf(highlight);
  if (idx === -1) return { before: text, match: "", after: "" };
  return {
    before: text.slice(0, idx),
    match: highlight,
    after: text.slice(idx + highlight.length),
  };
}
---

<Layout currentPage="home" canonicalPath="/">
  <!-- =====================================================================
       1. FULL-BLEED CELESTIAL HORIZON HERO + LIVE TIMETABLE RESOLVER
       ===================================================================== -->
  <section class="hero-horizon">
    <CelestialSky showRadarArcs={true} fadeBottom={true} />

    <div class="container hero-grid">
      <div class="hero-copy">
        <h1 class="hero-title">Turn messy class announcements into a calm semester radar.</h1>

        <p class="hero-sub">
          QuizRadar checks Gmail, Microsoft Teams, Moodle, Google Classroom, and Canvas directly on
          your device — anchoring fuzzy professor dates to your enrolled timetable with zero servers
          and zero accounts.
        </p>

        <div class="hero-actions">
          <a
            href={downloadHref}
            class="btn btn-sky-primary btn-lg"
            data-dl-cta
            data-download-base={downloadHref}
            data-web-href={webAppHref}
          >
            <BrandIcon name="download" size={18} />
            <span data-dl-label>Download QuizRadar</span>
          </a>

          <a
            href={webAppHref}
            class="btn btn-sky-secondary btn-lg"
            data-secondary-cta
            data-download-base={downloadHref}
            data-web-href={webAppHref}
          >
            <BrandIcon name="globe" size={18} />
            <span data-secondary-label>Try Web App in Browser</span>
          </a>
        </div>

        <ul class="hero-proof-strip" aria-label="Core guarantees">
          <li>
            <BrandIcon name="check" size={14} />
            <span>Free &amp; MIT Open Source</span>
          </li>
          <li>
            <BrandIcon name="check" size={14} />
            <span>100% Local &amp; Offline</span>
          </li>
          <li>
            <BrandIcon name="check" size={14} />
            <a href={downloadHref} class="hero-platforms-link tabular">
              v{APP_VERSION} · Windows, macOS, Linux, Android &amp; Web
            </a>
          </li>
        </ul>
      </div>

      <!-- Interactive Live Timetable Resolver Specimen (Persuade focal proof) -->
      <div class="resolver-bench" aria-label="Interactive timetable resolver demo">
        <div class="resolver-head">
          <span class="resolver-heading">Try a real campus message</span>
          <div class="resolver-tabs" role="tablist" aria-label="Campus announcement scenarios">
            {
              RESOLVER_SCENARIOS.map((sc, idx) => (
                <button
                  type="button"
                  role="tab"
                  id={`resolver-tab-${sc.id}`}
                  aria-selected={idx === 0 ? "true" : "false"}
                  aria-controls={`resolver-panel-${sc.id}`}
                  tabindex={idx === 0 ? 0 : -1}
                  class:list={["resolver-tab", { "is-active": idx === 0 }]}
                  data-resolver-tab={sc.id}
                >
                  {sc.tabLabel}
                </button>
              ))
            }
          </div>
        </div>

        {
          RESOLVER_SCENARIOS.map((sc, idx) => {
            const parts = splitHighlight(sc.announcement, sc.highlight);
            return (
              <div
                role="tabpanel"
                id={`resolver-panel-${sc.id}`}
                aria-labelledby={`resolver-tab-${sc.id}`}
                hidden={idx !== 0}
                class="resolver-panel"
                data-resolver-panel={sc.id}
              >
                <div class="resolver-meta-row">
                  <span class="resolver-course" style={`--course-dot: ${sc.courseColor};`}>
                    <span class="resolver-dot" aria-hidden="true" />
                    <span class="resolver-code tabular">{sc.courseCode}</span>
                    <span class="resolver-course-name">{sc.courseName}</span>
                  </span>
                  <span class="resolver-source">{sc.sourceLabel}</span>
                </div>

                <blockquote class="resolver-quote">{`“${parts.before}`}<mark class="resolver-mark">{parts.match}</mark>{`${parts.after}”`}</blockquote>

                <div class="resolver-bridge">
                  <span class="resolver-bridge-line" aria-hidden="true" />
                  <span class="resolver-bridge-pill">
                    <BrandIcon name="calendar" size={13} />
                    <span>{sc.timetableMatch}</span>
                  </span>
                  <span class="resolver-bridge-line" aria-hidden="true" />
                </div>

                <div class:list={["resolver-slot", `signal-${sc.signalKind}`]}>
                  <div class="resolver-slot-top">
                    <span class="resolver-signal-pill">{sc.signalLabel}</span>
                    <span class="resolver-room-readout tabular">
                      Room{" "}
                      <strong class:list={{ "is-tba": sc.resolvedRoom === "—" }}>
                        {sc.resolvedRoom}
                      </strong>
                    </span>
                  </div>
                  <div class="resolver-slot-title">{sc.resolvedTitle}</div>
                  <div class="resolver-slot-time tabular">
                    {sc.resolvedDate} &middot; {sc.resolvedTime}
                  </div>
                </div>

                <p class="resolver-honesty">
                  <BrandIcon name="check" size={14} />
                  <span>{sc.honestyNote}</span>
                </p>
              </div>
            );
          })
        }
      </div>
    </div>
  </section>

  <!-- =====================================================================
       2. REAL 2x RETINA PRODUCT STAGE (`#views`) — 6 VIEWS × 3 THEMES
       ===================================================================== -->
  <section id="views" class="band views-band">
    <div class="container">
      <div class="editorial-head">
        <h2 class="section-title">One calm workspace for your entire semester.</h2>
        <p class="section-lead">
          Every screen below is captured directly from QuizRadar v{APP_VERSION}. Preview{" "}
          <strong>Obsidian</strong>, <strong>Solar</strong>, and <strong>AMOLED</strong> live across
          all six views.
        </p>
      </div>

      <div class="stage-shell">
        <div class="stage-bar">
          <div
            class="stage-tablist"
            role="tablist"
            aria-orientation="horizontal"
            aria-label="QuizRadar desktop application views"
          >
            {
              PRODUCT_VIEWS.map((view, idx) => (
                <button
                  type="button"
                  role="tab"
                  id={`view-tab-${view.id}`}
                  aria-selected={idx === 0 ? "true" : "false"}
                  aria-controls={`view-panel-${view.id}`}
                  tabindex={idx === 0 ? 0 : -1}
                  class:list={["stage-tab", { "is-active": idx === 0 }]}
                  data-view-tab={view.id}
                >
                  {view.tabLabel}
                </button>
              ))
            }
          </div>

          <!-- Inline 3-Theme Observatory Preview Switcher right on the stage -->
          <div class="stage-theme-bar" role="group" aria-label="Preview screenshot theme">
            <button
              type="button"
              class="stage-theme-btn is-active"
              data-set-theme="obsidian"
              aria-pressed="true"
              aria-label="Preview Obsidian dark theme"
            >
              <BrandIcon name="moon" size={13} />
              <span>Obsidian</span>
            </button>
            <button
              type="button"
              class="stage-theme-btn"
              data-set-theme="solar"
              aria-pressed="false"
              aria-label="Preview Solar light theme"
            >
              <BrandIcon name="sun" size={13} />
              <span>Solar</span>
            </button>
            <button
              type="button"
              class="stage-theme-btn"
              data-set-theme="amoled-nebula"
              aria-pressed="false"
              aria-label="Preview AMOLED black theme"
            >
              <BrandIcon name="eclipse" size={13} />
              <span>AMOLED</span>
            </button>
          </div>
        </div>

        <div class="stage-panels">
          {
            PRODUCT_VIEWS.map((view, idx) => (
              <div
                role="tabpanel"
                id={`view-panel-${view.id}`}
                aria-labelledby={`view-tab-${view.id}`}
                hidden={idx !== 0}
                class="stage-panel"
                data-view-panel={view.id}
              >
                <div class="stage-caption-row">
                  <div class="stage-caption-main">
                    <span class="stage-badge tabular">{view.badge}</span>
                    <p class="stage-caption-text">{view.caption}</p>
                  </div>
                  <ul class="stage-highlights">
                    {view.highlights.map((hl) => (
                      <li>
                        <BrandIcon name="check" size={14} />
                        <span>{hl}</span>
                      </li>
                    ))}
                  </ul>
                </div>

                <div class="stage-frame">
                  <img
                    class="screenshot-outline stage-img"
                    data-theme-img
                    src={withBase(base, view.darkSrc)}
                    data-src-dark={withBase(base, view.darkSrc)}
                    data-src-light={withBase(base, view.lightSrc)}
                    data-src-amoled={withBase(base, view.amoledSrc)}
                    alt={view.alt}
                    width="2640"
                    height="1650"
                    loading={idx === 0 ? "eager" : "lazy"}
                    fetchpriority={idx === 0 ? "high" : undefined}
                    decoding="async"
                  />
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <!-- =====================================================================
       3. EXAM-WEEK ACADEMIC SUITE (`#suite`, TINTED BAND — UN-CROPPED)
       ===================================================================== -->
  <section id="suite" class="band band-tinted">
    <div class="container">
      <div class="editorial-head">
        <h2 class="section-title">Built for real exam weeks, not toy to-do lists.</h2>
        <p class="section-lead">
          Open any assessment to tick off syllabus topics, launch a Pomodoro focus block, drill
          practice questions offline, and calculate the exact score you need for your target grade.
        </p>
      </div>

      <div class="suite-split">
        <!-- Tightly framed full Assessment Detail sheet showing all actions & What-If calculator -->
        <figure class="suite-visual">
          <div class="suite-shot-frame">
            <img
              class="screenshot-outline suite-img"
              data-theme-img
              src={withBase(base, "/screenshots/app-detail-dark.webp")}
              data-src-dark={withBase(base, "/screenshots/app-detail-dark.webp")}
              data-src-light={withBase(base, "/screenshots/app-detail-light.webp")}
              data-src-amoled={withBase(base, "/screenshots/app-detail-amoled.webp")}
              alt="QuizRadar Assessment Detail sheet showing Date and Room CS Lab 3, checkable Syllabus Topics with Pomodoro timers, Deterministic Planner note, Google Calendar and .ics export, Practice Quiz button, and Grade Recording & What-If calculator."
              width="1720"
              height="1948"
              loading="eager"
              decoding="async"
            />
          </div>
          <figcaption class="suite-figcaption">
            Every assessment sheet keeps the resolved time &amp; room, checkable syllabus topics,
            per-topic Pomodoro launcher, Practice Quiz drill, one-click <code>.ics</code> export,
            and Grade What-If calculator in one place.
          </figcaption>
        </figure>

        <!-- Structured hairline editorial ledger -->
        <div class="suite-ledger">
          {
            SUITE_FEATURES.map((feat, idx) => (
              <div class="suite-row">
                <div class="suite-row-marker">
                  <span class="suite-row-num tabular">0{idx + 1}</span>
                  <div class="suite-row-icon">
                    <BrandIcon name={feat.icon} size={17} />
                  </div>
                </div>
                <div class="suite-row-copy">
                  <h3>{feat.title}</h3>
                  <p>{feat.body}</p>
                  {feat.id === "shortcuts" && (
                    <div class="shortcut-bar" aria-label="Desktop keyboard shortcuts">
                      <span>
                        <kbd class="keycap">1</kbd>–<kbd class="keycap">4</kbd> Views
                      </span>
                      <span>
                        <kbd class="keycap">T</kbd> Today
                      </span>
                      <span>
                        <kbd class="keycap">N</kbd> New event
                      </span>
                      <span>
                        <kbd class="keycap">Space</kbd> Pomodoro
                      </span>
                      <span>
                        <kbd class="keycap">/</kbd> Search
                      </span>
                    </div>
                  )}
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <!-- =====================================================================
       4. ZERO-SERVER PRIVACY & CAMPUS SOURCES DATA-FLOW (`#sources`)
       ===================================================================== -->
  <section id="sources" class="band">
    <div class="container">
      <div class="editorial-head">
        <h2 class="section-title">Connects straight to your campus — never through our servers.</h2>
        <p class="section-lead">
          Your device speaks directly to Google, Microsoft, Moodle, or your university calendar
          feed. Tokens stay locked inside your OS vault, and syncing between devices transfers only
          schedule data.
        </p>
      </div>

      <!-- Visual 3-Column Local-First Architecture Flow -->
      <div class="flow-diagram">
        <!-- Left Column: Campus Inputs -->
        <div class="flow-col">
          <div class="flow-col-head">
            <h3>Campus Inputs</h3>
            <span>Direct on-device read</span>
          </div>
          <ul class="flow-list">
            {
              inputSources.map((src) => (
                <li class="flow-node">
                  <span class="flow-node-icon">
                    <BrandIcon name={src.id} size={20} />
                  </span>
                  <div class="flow-node-copy">
                    <div class="flow-node-top">
                      <strong>{src.name}</strong>
                      <span class="flow-proto">{src.protocol}</span>
                    </div>
                    <p>{src.summary}</p>
                  </div>
                </li>
              ))
            }
          </ul>
        </div>

        <!-- Center Hub: Your Device Vault -->
        <div class="flow-hub">
          <div class="flow-connector flow-connector-in" aria-hidden="true">
            <span class="flow-arrow-line" />
            <BrandIcon name="arrow-right" size={15} />
          </div>

          <div class="vault-core">
            <div class="vault-emblem">
              <BrandIcon name="quizradar" size={44} animated={true} uid="vault" />
            </div>
            <h3 class="vault-title">Your Device Only</h3>
            <p class="vault-sub">
              Pure-Rust local engine + SQLite / IndexedDB. OAuth tokens live strictly in Windows
              Credential Manager, macOS Keychain, Linux Secret Service, or Android Keystore.
            </p>
            <div class="vault-seal">
              <BrandIcon name="lock" size={14} />
              <span>0 bytes sent to QuizRadar servers</span>
            </div>
            <ul class="vault-facts">
              <li>Zero user accounts or sign-up walls</li>
              <li>Zero analytics, trackers, or telemetry</li>
              <li>Works 100% offline with deterministic rules</li>
            </ul>
          </div>

          <div class="flow-connector flow-connector-out" aria-hidden="true">
            <span class="flow-arrow-line" />
            <BrandIcon name="arrow-right" size={15} />
          </div>
        </div>

        <!-- Right Column: Exports & Sync -->
        <div class="flow-col">
          <div class="flow-col-head">
            <h3>Exports &amp; Device Sync</h3>
            <span>Data-only · user-initiated</span>
          </div>
          <ul class="flow-list">
            {
              outputSources.map((src) => (
                <li class="flow-node">
                  <span class="flow-node-icon">
                    <BrandIcon name={src.id} size={20} />
                  </span>
                  <div class="flow-node-copy">
                    <div class="flow-node-top">
                      <strong>{src.name}</strong>
                      <span class="flow-proto">{src.protocol}</span>
                    </div>
                    <p>{src.summary}</p>
                  </div>
                </li>
              ))
            }
          </ul>
        </div>
      </div>

      <!-- Honesty Doctrine 3-column hairline bar -->
      <div class="honesty-bar">
        <div class="honesty-col">
          <h3>Unannounced rooms stay “—”</h3>
          <p>
            QuizRadar never fabricates rooms, instructors, or due dates. Every anchored exam retains
            the professor’s original quote so you can double-check it instantly.
          </p>
        </div>
        <div class="honesty-col">
          <h3>No AI key required</h3>
          <p>
            All parsing, conflict detection, GPA math, and Leitner flashcards work offline with zero
            API keys. Optional BYOK Google Gemini stays off by default.
          </p>
        </div>
        <div class="honesty-col">
          <h3>Ephemeral LAN QR sync</h3>
          <p>
            Sync Desktop and Android over local Wi-Fi with one QR scan using a per-session pinned
            TLS certificate that auto-closes after a single bidirectional merge.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- =====================================================================
       5. NATIVE ANDROID COMPANION (`#android`, TINTED BAND)
       ===================================================================== -->
  <section id="android" class="band band-tinted">
    <div class="container android-grid">
      <div class="android-copy">
        <h2 class="section-title">Your exam countdown and today’s classes, right on Android.</h2>
        <p class="section-lead">
          A fast, native Jetpack Compose app sharing the exact same Rust engine — built for glancing
          between lectures, marking attendance in one tap, and staying on top of exam day.
        </p>

        <!-- Interactive 4x2 / 2x1 Android Glance Widget Switcher -->
        <div class="widget-showcase">
          <div class="widget-switch-bar">
            <span class="widget-switch-label">Home-Screen Glance Widgets</span>
            <div class="widget-pills" role="tablist" aria-label="Android home-screen widget sizes">
              <button
                type="button"
                role="tab"
                id="widget-tab-4x2"
                aria-selected="true"
                aria-controls="widget-panel-4x2"
                tabindex={0}
                class="widget-pill is-active"
                data-widget-tab="4x2"
              >
                4×2 Today’s Schedule
              </button>
              <button
                type="button"
                role="tab"
                id="widget-tab-2x1"
                aria-selected="false"
                aria-controls="widget-panel-2x1"
                tabindex={-1}
                class="widget-pill"
                data-widget-tab="2x1"
              >
                2×1 Exam Countdown
              </button>
            </div>
          </div>

          <!-- 4x2 Today's Schedule Widget -->
          <div
            role="tabpanel"
            id="widget-panel-4x2"
            aria-labelledby="widget-tab-4x2"
            class="glance-widget glance-4x2"
            data-widget-panel="4x2"
          >
            <CelestialSky showRadarArcs={false} compact={true} />
            <div class="glance-inner">
              <div class="glance-top">
                <span class="amber-pill glance-pill">
                  <BrandIcon name="zap" size={11} />
                  <span>Today · Mon, Nov 2</span>
                </span>
                <span class="glance-course tabular">Next exam in 1d</span>
              </div>
              <ul class="glance-schedule-list">
                <li>
                  <span class="glance-slot-time tabular">09:00</span>
                  <span class="glance-slot-name">CS301 Algorithms Lecture</span>
                  <span class="glance-slot-room tabular">Hall 302</span>
                </li>
                <li>
                  <span class="glance-slot-time tabular">14:00</span>
                  <span class="glance-slot-name">PHYS102 Electromagnetism</span>
                  <span class="glance-slot-room tabular">Sci 101</span>
                </li>
                <li class="is-due">
                  <span class="glance-slot-time tabular">17:00</span>
                  <span class="glance-slot-name">Due · Problem Set 4</span>
                  <span class="glance-slot-room tabular">—</span>
                </li>
              </ul>
            </div>
          </div>

          <!-- 2x1 Exam Countdown Widget -->
          <div
            role="tabpanel"
            id="widget-panel-2x1"
            aria-labelledby="widget-tab-2x1"
            hidden
            class="glance-widget"
            data-widget-panel="2x1"
          >
            <CelestialSky showRadarArcs={false} compact={true} />
            <div class="glance-inner">
              <div class="glance-top">
                <span class="amber-pill glance-pill">
                  <BrandIcon name="zap" size={11} />
                  <span>Up next · In 3d</span>
                </span>
                <span class="glance-course tabular">CSE 341</span>
              </div>
              <div class="glance-title">Class Quiz 2 — CPU Scheduling</div>
              <div class="glance-meta tabular">Thu, Nov 5 &middot; 10:00 AM &middot; CS Lab 3</div>
            </div>
          </div>

          <!-- Authentic T-3h Persistent Lock-Screen Exam Chronometer Strip -->
          <div class="lock-notif">
            <BrandIcon name="clock" size={15} />
            <div class="lock-notif-copy">
              <strong>T-3h Lock-Screen Exam Chronometer</strong>
              <span>Ongoing live countdown with room code starting 3 hours before exam time.</span>
            </div>
          </div>
        </div>

        <ul class="android-points">
          <li>
            <BrandIcon name="check" size={16} />
            <span>
              <strong>Attendance &amp; Absence Limits:</strong> Tap any class slot in Agenda view to
              mark Present, Absent, or Excused — with automatic limit warnings.
            </span>
          </li>
          <li>
            <BrandIcon name="check" size={16} />
            <span>
              <strong>Share-Sheet Quick Add:</strong> Share a professor’s message from WhatsApp or
              Telegram straight into QuizRadar to capture a deadline in one tap.
            </span>
          </li>
          <li>
            <BrandIcon name="check" size={16} />
            <span>
              <strong>Hardware-Backed Vault + LAN QR Sync:</strong> Tokens stay inside Android
              Keystore; scan your laptop’s local Wi-Fi QR for an instant two-way merge.
            </span>
          </li>
        </ul>

        <div class="android-cta-row">
          <a href={`${downloadHref}#android`} class="btn btn-primary">
            <BrandIcon name="android" size={17} />
            <span>{PLATFORM_DOWNLOADS.android.label}</span>
          </a>
          <a href={`${downloadHref}#android`} class="btn btn-secondary">
            <span>QR &amp; SHA-256 Checksums</span>
          </a>
        </div>
      </div>

      <!-- Authentic Pixel-Style Android Bezel + 4-Screen Interactive Switcher -->
      <div class="android-stage">
        <div class="android-tabs" role="tablist" aria-label="Android app screens">
          {
            ANDROID_SCREENS.map((scr, idx) => (
              <button
                type="button"
                role="tab"
                id={`android-tab-${scr.id}`}
                aria-selected={idx === 0 ? "true" : "false"}
                aria-controls={`android-panel-${scr.id}`}
                tabindex={idx === 0 ? 0 : -1}
                class:list={["android-tab", { "is-active": idx === 0 }]}
                data-android-tab={scr.id}
              >
                {scr.label}
              </button>
            ))
          }
        </div>

        <div class="pixel-frame">
          <span class="pixel-camera" aria-hidden="true"></span>
          <span class="pixel-btn pixel-btn-power" aria-hidden="true"></span>
          <span class="pixel-btn pixel-btn-vol" aria-hidden="true"></span>
          <div class="pixel-screen">
            {
              ANDROID_SCREENS.map((scr, idx) => (
                <div
                  role="tabpanel"
                  id={`android-panel-${scr.id}`}
                  aria-labelledby={`android-tab-${scr.id}`}
                  hidden={idx !== 0}
                  class="android-screen-panel"
                  data-android-panel={scr.id}
                >
                  <img
                    class="pixel-img"
                    data-theme-img
                    src={withBase(base, scr.darkSrc)}
                    data-src-dark={withBase(base, scr.darkSrc)}
                    data-src-light={withBase(base, scr.lightSrc)}
                    data-src-amoled={withBase(base, scr.amoledSrc)}
                    alt={scr.alt}
                    width="1233"
                    height="2673"
                    loading={idx === 0 ? "eager" : "lazy"}
                    decoding="async"
                  />
                </div>
              ))
            }
          </div>
        </div>

        <p class="android-screen-caption" id="android-active-caption">
          {ANDROID_SCREENS[0].caption}
