<?xml version="1.0" encoding="utf-8"?>
<!-- The blue diagonal gradient behind the radar squircle.

     This is the background layer of the adaptive launcher icon. It carries
     the same gradient the desktop and the browser tiers ship (the v4
     `static/icon.svg`), so the icon on the home screen is the same picture
     as the mark inside the app. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path android:pathData="M0,0 H108 V108 H0 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="0"
                android:startY="0"
                android:endX="108"
                android:endY="108">
                <item
                    android:color="#1E3A8A"
                    android:offset="0" />
                <item
                    android:color="#1D4ED8"
                    android:offset="0.5" />
                <item
                    android:color="#2563EB"
                    android:offset="1" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
