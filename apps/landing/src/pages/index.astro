---
import Layout from "../layouts/Layout.astro";
import BrandIcon from "../components/BrandIcon.astro";
import CelestialSky from "../components/CelestialSky.astro";
import QRCode from "qrcode";
import {
  ANCHOR_STEPS,
  APP_VERSION,
  FAQ_ITEMS,
  INGESTION_SOURCES,
  PLATFORM_DOWNLOADS,
  PRODUCT_VIEWS,
  withBase,
} from "../lib/releaseData";

const base = import.meta.env.BASE_URL;
const downloadHref = withBase(base, "/download/");
const webAppHref = withBase(base, "/app/");

const androidQrSvg = await QRCode.toString(PLATFORM_DOWNLOADS.android.primaryUrl, {
  type: "svg",
  margin: 1,
  width: 108,
  color: {
    dark: "#0f172a",
    light: "#ffffff",
  },
});

function splitHighlight(text: string, highlight?: string) {
  if (!highlight || !text.includes(highlight)) {
    return { before: text, match: "", after: "" };
  }
  const idx = text.indexOf(highlight);
  return {
    before: text.slice(0, idx),
    match: highlight,
    after: text.slice(idx + highlight.length),
  };
}
---

<Layout currentPage="home" canonicalPath="/">
  <!-- =====================================================================
       1. CELESTIAL SKY HERO + REAL APPLICATION VIEWS STAGE
       ===================================================================== -->
  <section class="hero-section">
    <div class="container">
      <div class="hero-sky-card">
        <CelestialSky showRadarArcs={true} />

        <div class="hero-sky-content">
          <h1 class="hero-title">Turn chaotic class announcements into a calm semester schedule.</h1>

          <p class="hero-sub">
            QuizRadar reviews course updates from Gmail, Microsoft Teams, Moodle, and Google Classroom
            directly on your device, matching fuzzy dates against your enrolled class timetable. Every
            quiz, conflict warning, and study session appears on one clear calendar — completely private,
            free, and zero-server.
          </p>

          <div class="hero-actions">
            <a
              href={downloadHref}
              class="btn btn-sky-primary btn-lg"
              data-dl-cta
              data-default-href={downloadHref}
            >
              <BrandIcon name="download" size={18} />
              <span data-dl-label>Download QuizRadar</span>
            </a>

            <a href={webAppHref} class="btn btn-sky-secondary btn-lg">
              <BrandIcon name="globe" size={18} />
              <span>Try Web App in Browser</span>
            </a>
          </div>

          <div class="hero-foot-strip">
            <a href={downloadHref} class="sky-foot-link">
              Available for Windows, macOS, Linux, and Android &rarr;
            </a>
          </div>
        </div>
      </div>

      <!-- Real 2x Retina Product Stage (`#views`) -->
      <div id="views" class="stage-wrap">
        <div class="gradient-stage app-stage">
          <div class="stage-toolbar">
            <div class="stage-tablist" role="tablist" aria-orientation="horizontal" aria-label="QuizRadar application views">
              {
                PRODUCT_VIEWS.map((view, idx) => (
                  <button
                    type="button"
                    role="tab"
                    id={`tab-${view.id}`}
                    aria-selected={idx === 0 ? "true" : "false"}
                    aria-controls={`panel-${view.id}`}
                    tabindex={idx === 0 ? 0 : -1}
                    class:list={["stage-tab", { "is-active": idx === 0 }]}
                    data-view-tab={view.id}
                  >
                    {view.tabLabel}
                  </button>
                ))
              }
            </div>

            <button
              type="button"
              class="stage-sky-switch"
              data-theme-toggle
              aria-label="Preview screenshots in Day or Starry Night theme"
            >
              <span class="switch-sun">
                <BrandIcon name="sun" size={14} />
                <span>Switch to Day Sky</span>
              </span>
              <span class="switch-moon">
                <BrandIcon name="moon" size={14} />
                <span>Switch to Starry Sky</span>
              </span>
            </button>
          </div>

          <div class="stage-panels">
            {
              PRODUCT_VIEWS.map((view, idx) => (
                <div
                  role="tabpanel"
                  id={`panel-${view.id}`}
                  aria-labelledby={`tab-${view.id}`}
                  hidden={idx !== 0}
                  class="stage-panel"
                  data-view-panel={view.id}
                >
                  <div class="stage-frame">
                    <img
                      class="theme-shot-dark screenshot-outline stage-img"
                      src={withBase(base, view.darkSrc)}
                      alt={view.alt}
                      width="2160"
                      height="1350"
                      loading={idx === 0 ? "eager" : "lazy"}
                      fetchpriority={idx === 0 ? "high" : undefined}
                      decoding="async"
                    />
                    <img
                      class="theme-shot-light screenshot-outline stage-img"
                      src={withBase(base, view.lightSrc)}
                      alt={view.alt}
                      width="2160"
                      height="1350"
                      loading={idx === 0 ? "eager" : "lazy"}
                      decoding="async"
                    />
                  </div>

                  <div class="stage-caption-bar">
                    <div class="stage-caption-main">
                      <span class="stage-badge tabular">{view.badge}</span>
                      <p class="stage-caption-text">{view.caption}</p>
                    </div>
                    <span class="stage-provenance">Real app capture · Sample Fall 2026</span>
                  </div>
                </div>
              ))
            }
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- =====================================================================
       2. TIMETABLE ANCHOR SCROLL STORY (`scroll-progress-timeline`)
       ===================================================================== -->
  <section id="how-it-works" class="page-section">
    <div class="container">
      <div class="section-head animate-on-scroll">
        <h2 class="section-title">How fuzzy class messages become an exact study schedule.</h2>
        <p class="section-lead">
          Professors rarely send clean calendar invites. QuizRadar reads announcements the way
          students do &mdash; matching casual phrases against your weekly lectures, tutorials, and
          lab times.
        </p>
      </div>

      <div class="timeline-shell" data-scroll-timeline>
        <div class="timeline-rail" aria-hidden="true">
          <div class="timeline-fill" data-timeline-fill></div>
        </div>

        <ol class="timeline-list">
          {
            ANCHOR_STEPS.map((step, idx) => {
              const parts = splitHighlight(step.snippetText, step.highlight);
              return (
                <li
                  class:list={["timeline-step", { "is-active": idx === 0 }]}
                  data-timeline-step
                >
                  <div class="step-marker tabular" aria-hidden="true">
                    {step.number}
                  </div>

                  <div class="step-grid">
                    <div class="step-copy">
                      <span class="step-kicker">{step.kicker}</span>
                      <h3 class="step-title">{step.title}</h3>
                      <p class="step-body">{step.body}</p>
                    </div>

                    <div class="anchor-card">
                      <div class="anchor-card-top">
                        <span
                          class="course-chip"
                          style={`--chip-color: ${step.courseColor};`}
                        >
                          <span class="course-dot" aria-hidden="true" />
                          <span>{step.courseCode}</span>
                          <span class="course-chip-sep">·</span>
                          <span class="course-chip-name">{step.courseName}</span>
                        </span>
                        <span class="snippet-source">{step.snippetLabel}</span>
                      </div>

                      <blockquote class="snippet-quote">
                        {
                          parts.match ? (
                            <>
                              <span>{`“${parts.before}`}</span><mark class="phrase-mark">{parts.match}</mark><span>{`${parts.after}”`}</span>
                            </>
                          ) : (
                            <span>{`“${parts.before}”`}</span>
                          )
                        }
                      </blockquote>

                      <div class="resolved-grid">
                        <div class="resolved-cell">
                          <span class="resolved-label">Anchored Slot</span>
                          <span class="resolved-val tabular">{step.resolvedDate}</span>
                        </div>
                        <div class="resolved-cell">
                          <span class="resolved-label">Room</span>
                          <span
                            class:list={[
                              "resolved-val",
                              "tabular",
                              { "is-unassigned": step.resolvedRoom === "—" },
                            ]}
                          >
                            {step.resolvedRoom}
                          </span>
                        </div>
                      </div>

                      <div class="honesty-strip">
                        <BrandIcon name="check" size={14} />
                        <span>{step.honestyNote}</span>
                      </div>
                    </div>
                  </div>
                </li>
              );
            })
          }
        </ol>
      </div>
    </div>
  </section>

  <!-- =====================================================================
       3. DIRECT CAMPUS SOURCES (`#sources`)
       ===================================================================== -->
  <section id="sources" class="page-section">
    <div class="container">
      <div class="section-head animate-on-scroll">
        <h2 class="section-title">Connects directly to your university tools &mdash; never through our servers.</h2>
        <p class="section-lead">
          Your device connects straight to Google, Microsoft, or your campus Moodle portal.
          Your passwords and access tokens stay locked in your device's secure vault and never
          pass through an outside relay.
        </p>
      </div>

      <div class="sources-ledger animate-on-scroll">
        {
          INGESTION_SOURCES.map((source) => (
            <article class="source-cell">
              <div class="source-cell-head">
                <div class="source-icon-wrap">
                  <BrandIcon name={source.id} size={22} />
                </div>
                <div class="source-meta">
                  <h3>{source.name}</h3>
                  <span class="protocol-tag">{source.protocol}</span>
                </div>
              </div>
              <p class="source-summary">{source.summary}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- =====================================================================
       4. BUILT FOR REAL EXAM WEEKS (CALENDAR, FOCUS & HONEST GRADES)
       ===================================================================== -->
  <section class="page-section">
    <div class="container">
      <div class="section-head animate-on-scroll">
        <h2 class="section-title">Everything you need for exam week, built into one calm workspace.</h2>
        <p class="section-lead">
          Once an exam is scheduled, QuizRadar flags tight deadlines, sets aside focused study blocks in
          your free hours, and tracks topic progress without clutter.
        </p>
      </div>

      <div class="workflow-split">
        <article class="workflow-card workflow-card-wide animate-on-scroll">
          <div class="workflow-copy">
            <h3>Classes, confirmed exams, and dedicated study time on one clear weekly grid</h3>
            <p>
              Anchored quizzes appear inside the exact lecture or lab slot where they take place. When
              two exams or major deadlines land close together, one click schedules quiet study sessions
              in your free time &mdash; ready to export to Google Calendar or save as an <code>.ics</code>
              file.
            </p>
          </div>
          <div class="workflow-shot-wrap">
            <img
              class="theme-shot-dark screenshot-outline workflow-shot"
              src={withBase(base, "/screenshots/app-calendar-dark.webp")}
              alt="QuizRadar Week Calendar with glowing red Class Quiz 2 slot and scheduled study sessions."
              width="2160"
              height="1350"
              loading="lazy"
              decoding="async"
            />
            <img
              class="theme-shot-light screenshot-outline workflow-shot"
              src={withBase(base, "/screenshots/app-calendar-light.webp")}
              alt="QuizRadar Week Calendar in Day mode with glowing Class Quiz 2 slot and study sessions."
              width="2160"
              height="1350"
              loading="lazy"
              decoding="async"
            />
          </div>
        </article>

        <article
          class="workflow-card animate-on-scroll"
          style="--reveal-delay: 80ms;"
        >
          <div class="workflow-copy">
            <h3>Checkable syllabus topics, Pomodoro focus, and Grade What-If</h3>
            <p>
              Break each exam into concrete topics, launch a built-in 25-minute focus session, drill
              sample questions offline (or connect an optional AI key), and calculate the exact
              exam score needed for your target grade.
            </p>
          </div>
          <div class="workflow-shot-wrap">
            <img
              class="theme-shot-dark screenshot-outline workflow-shot"
              src={withBase(base, "/screenshots/app-detail-dark.webp")}
              alt="QuizRadar Assessment Detail modal showing study topics, Pomodoro timer button, and Grade What-If calculator."
              width="2160"
              height="1350"
              loading="lazy"
              decoding="async"
            />
            <img
              class="theme-shot-light screenshot-outline workflow-shot"
              src={withBase(base, "/screenshots/app-detail-light.webp")}
              alt="QuizRadar Assessment Detail modal in Day mode showing study topics and Grade What-If calculator."
              width="2160"
              height="1350"
              loading="lazy"
              decoding="async"
            />
          </div>
        </article>
      </div>
    </div>
  </section>

  <!-- =====================================================================
       5. FREQUENTLY ASKED QUESTIONS (`#faq`)
       ===================================================================== -->
  <section id="faq" class="page-section">
    <div class="container faq-container">
      <div class="section-head text-center animate-on-scroll">
        <h2 class="section-title">Everything about QuizRadar, answered.</h2>
      </div>

      <div class="faq-list faq-list-centered animate-on-scroll" style="--reveal-delay: 80ms;">
        {
          FAQ_ITEMS.map((item, idx) => (
            <details class="faq-item" open={idx === 0}>
              <summary class="faq-summary">
                <span>{item.question}</span>
                <BrandIcon name="chevron-down" size={18} class="faq-chevron" />
              </summary>
              <p class="faq-answer">{item.answer}</p>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <!-- =====================================================================
       6. MOBILE COMPANION (PLATFORM-SPECIFIC BOTTOM CARD WITH QR CODE) (`#android`)
       ===================================================================== -->
  <section id="android" class="page-section companion-section">
    <div class="container companion-container">
      <div class="companion-card animate-on-scroll">
        <!-- Desktop / Laptop View with QR Code -->
        <div class="companion-desktop">
          <div class="companion-qr-box">
            <div class="companion-qr-svg" set:html={androidQrSvg} aria-label="QR code to download QuizRadar Android APK" />
            <span class="companion-qr-label">Scan to install</span>
          </div>

          <div class="companion-content">
            <div class="companion-tag">
              <BrandIcon name="android" size={15} />
              <span>Android Companion</span>
            </div>
            <h3 class="companion-title">Take your countdown with you.</h3>
            <p class="companion-desc">
              Scan the QR code with your phone camera to install the native Android app &mdash; with 2&times;1 home-screen countdown widgets, local 24h exam notifications, and WhatsApp/Telegram class chat share-sheet ingest.
            </p>
            <div class="companion-links">
              <a href={PLATFORM_DOWNLOADS.android.primaryUrl} class="btn btn-secondary btn-sm">
                <BrandIcon name="download" size={15} />
                <span>Direct APK (v{APP_VERSION})</span>
              </a>
              <a href={downloadHref} class="companion-alt-link">
                All platform downloads &rarr;
              </a>
            </div>
          </div>
        </div>

        <!-- Mobile / Touch View (Direct 1-Tap) -->
        <div class="companion-mobile">
          <div class="companion-tag">
            <BrandIcon name="android" size={15} />
            <span>Android App</span>
          </div>
          <h3 class="companion-title">QuizRadar for Android</h3>
          <p class="companion-desc">
            Fast, native Material 3 app with 2&times;1 home-screen countdown widgets and on-device exam reminders.
          </p>
          <a href={PLATFORM_DOWNLOADS.android.primaryUrl} class="btn btn-primary btn-lg">
            <BrandIcon name="download" size={18} />
            <span>Download Android APK</span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- =====================================================================
       7. STARRY HORIZON FINALE
       ===================================================================== -->
  <section class="finale-section">
    <div class="container">
      <div class="finale-card animate-on-scroll">
        <CelestialSky showRadarArcs={true} />
        <div class="finale-inner">
          <BrandIcon name="quizradar" size={56} animated={true} class="finale-logo" />
          <h2 class="finale-title">Put your semester on the radar.</h2>
          <p class="finale-sub">
            Free, private, and open source under the MIT License. Install on your laptop or phone
            for automatic schedule checks, or try the Web App instantly in your browser.
          </p>
          <div class="finale-actions">
            <a
              href={PLATFORM_DOWNLOADS.windows.primaryUrl}
              class="btn btn-sky-primary btn-lg"
              data-dl-cta
            >
              <BrandIcon name="download" size={18} />
              <span data-dl-label>{PLATFORM_DOWNLOADS.windows.label}</span>
            </a>
            <a href={downloadHref} class="btn btn-sky-secondary btn-lg">
              <span>All Platforms & Checksums</span>
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>

<script>
  import { detectClientPlatform, PLATFORM_DOWNLOADS } from "../lib/releaseData";

  // 1. OS-aware primary download CTA routing
  const os = detectClientPlatform(
    navigator.userAgent || "",
    (navigator as Navigator & { userAgentData?: { platform?: string } }).userAgentData?.platform ||
      navigator.platform ||
      "",
  );
  const target = PLATFORM_DOWNLOADS[os];
  document.querySelectorAll<HTMLAnchorElement>("[data-dl-cta]").forEach((anchor) => {
    anchor.href = target.primaryUrl;
  });
  document.querySelectorAll<HTMLElement>("[data-dl-label]").forEach((span) => {
    span.textContent = target.label;
  });

  // 2. Accessible Roving-Tabindex Real App View Switcher
  const tabs = Array.from(document.querySelectorAll<HTMLButtonElement>("[data-view-tab]"));
  const panels = Array.from(document.querySelectorAll<HTMLElement>("[data-view-panel]"));

  const activateView = (viewId: string, focusTab = false) => {
    tabs.forEach((tab) => {
      const active = tab.dataset.viewTab === viewId;
      tab.classList.toggle("is-active", active);
      tab.setAttribute("aria-selected", active ? "true" : "false");
      tab.tabIndex = active ? 0 : -1;
      if (active && focusTab) tab.focus();
    });
    panels.forEach((panel) => {
      panel.hidden = panel.dataset.viewPanel !== viewId;
    });
  };

  tabs.forEach((tab, index) => {
    tab.addEventListener("click", () => {
      if (tab.dataset.viewTab) activateView(tab.dataset.viewTab, false);
    });

    tab.addEventListener("keydown", (event) => {
      let nextIndex: number | null = null;
      if (event.key === "ArrowRight") nextIndex = (index + 1) % tabs.length;
      else if (event.key === "ArrowLeft") nextIndex = (index - 1 + tabs.length) % tabs.length;
      else if (event.key === "Home") nextIndex = 0;
      else if (event.key === "End") nextIndex = tabs.length - 1;

      if (nextIndex !== null) {
        event.preventDefault();
        const nextId = tabs[nextIndex]?.dataset.viewTab;
        if (nextId) activateView(nextId, true);
      }
    });
  });

  // 3. Scroll-Progress Timeline (`scroll-progress-timeline`, compositor-only `scaleY`)
  const timeline = document.querySelector<HTMLElement>("[data-scroll-timeline]");
  const fill = document.querySelector<HTMLElement>("[data-timeline-fill]");
  const stepEls = Array.from(document.querySelectorAll<HTMLElement>("[data-timeline-step]"));

  if (timeline && fill && stepEls.length > 0) {
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
      fill.style.setProperty("--timeline-progress", "1");
      stepEls.forEach((el) => el.classList.add("is-active"));
    } else {
      let ticking = false;
      const updateTimeline = () => {
        ticking = false;
        const rect = timeline.getBoundingClientRect();
        const triggerY = window.innerHeight * 0.62;
        const raw = (triggerY - rect.top) / Math.max(rect.height, 1);
        const clamped = Math.min(1, Math.max(0.06, raw));
        fill.style.setProperty("--timeline-progress", clamped.toFixed(4));

        stepEls.forEach((step, idx) => {
          const sRect = step.getBoundingClientRect();
          const reached = idx === 0 || sRect.top <= triggerY;
          step.classList.toggle("is-active", reached);
        });
      };

      const requestTick = () => {
        if (!ticking) {
          ticking = true;
          window.requestAnimationFrame(updateTimeline);
        }
      };

      window.addEventListener("scroll", requestTick, { passive: true });
      window.addEventListener("resize", requestTick, { passive: true });
      updateTimeline();
    }
  }
</script>

<style>
  /* -------------------------------------------------------------------------
     1. Hero Celestial Canopy + Real App Views Stage
     ------------------------------------------------------------------------- */
  .hero-section {
    padding-block: 16px 52px;
  }

  .hero-sky-card {
    position: relative;
    border-radius: 28px;
    overflow: hidden;
    padding: 42px 48px 84px;
    color: #ffffff;
    box-shadow: var(--shadow-lg);
    border: 1px solid rgba(255, 255, 255, 0.14);
  }

  .hero-sky-content {
    position: relative;
    z-index: 1;
    max-width: 820px;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 16px;
  }

  .hero-title {
    font-size: clamp(1.85rem, 5.2vw, 3.85rem);
    font-weight: 800;
    line-height: 1.06;
    letter-spacing: -0.032em;
    color: #ffffff;
    text-shadow: 0 2px 24px rgba(2, 6, 23, 0.28);
  }

  .hero-sub {
    font-size: clamp(1rem, 1.35vw, 1.15rem);
    line-height: 1.62;
    color: rgba(241, 245, 249, 0.9);
    max-width: 63ch;
    text-wrap: pretty;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px;
    margin-block-start: 4px;
  }

  .hero-foot-strip {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    font-size: 0.81rem;
    color: rgba(226, 232, 240, 0.86);
    margin-block-start: 2px;
  }

  .sky-foot-link {
    font-weight: 600;
    color: #ffffff;
    text-decoration: underline;
    text-decoration-color: rgba(255, 255, 255, 0.42);
    text-underline-offset: 3px;
    transition-property: color, text-decoration-color;
    transition-duration: 150ms;
    transition-timing-function: var(--ease-snappy);
  }

  /* Overlapping Real Product Stage */
  .stage-wrap {
    position: relative;
    z-index: 2;
    margin-block-start: -52px;
    padding-inline: 22px;
    min-width: 0;
    max-width: 100%;
  }

  .app-stage {
    border-radius: 20px;
    overflow: hidden;
    min-width: 0;
    max-width: 100%;
  }

  .stage-toolbar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 12px 16px;
    background-color: var(--surface-elevated);
    border-block-end: 1px solid var(--surface-border);
    min-width: 0;
    max-width: 100%;
  }

  .stage-tablist {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 4px;
    min-width: 0;
    max-width: 100%;
  }

  .stage-tab {
    padding: 7px 13px;
    border-radius: 10px;
    font-size: 0.815rem;
    font-weight: 600;
    color: var(--text-muted);
    transition-property: transform, color, background-color, box-shadow;
    transition-duration: 150ms;
    transition-timing-function: var(--ease-snappy);
  }

  .stage-tab:active {
    transform: scale(0.96);
  }

  .stage-tab.is-active {
    background-color: var(--accent-fill);
    color: #ffffff;
    box-shadow: var(--shadow-sm);
  }

  .stage-sky-switch {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 6px 11px;
    border-radius: 9px;
    border: 1px solid var(--surface-border);
    background-color: var(--surface);
    font-size: 0.76rem;
    font-weight: 600;
    color: var(--text-secondary);
    transition-property: transform, border-color, background-color, color;
    transition-duration: 150ms;
    transition-timing-function: var(--ease-snappy);
  }

  .stage-sky-switch:active {
    transform: scale(0.96);
  }

  .switch-sun {
    display: none;
    align-items: center;
    gap: 6px;
  }

  .switch-sun :global(svg) {
    color: #fbbf24;
