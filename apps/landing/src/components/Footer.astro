---
import BrandIcon from "./BrandIcon.astro";
import {
  APP_VERSION,
  CHECKSUMS_URL,
  GITHUB_RELEASES_LATEST,
  GITHUB_RELEASE_TAG_URL,
  GITHUB_REPO_URL,
  withBase,
} from "../lib/releaseData";

const base = import.meta.env.BASE_URL;
const homeHref = withBase(base, "/");
const downloadHref = withBase(base, "/download/");
const webAppHref = withBase(base, "/app/");
const privacyHref = withBase(base, "/privacy/");
const termsHref = withBase(base, "/terms/");
---

<footer class="footer">
  <div class="container">
    <div class="footer-grid">
      <div class="footer-brand-col">
        <a href={homeHref} class="footer-brand">
          <BrandIcon name="quizradar" size={28} uid="footer" class="footer-mark" />
          <span class="footer-name">QuizRadar</span>
        </a>
        <p class="footer-tagline">
          A quiet, local-first exam radar for university students. Built once around an honest
          timetable engine — free, MIT open source, with zero backend servers and zero telemetry.
        </p>
        <div class="footer-release-row">
          <a
            href={GITHUB_RELEASE_TAG_URL}
            target="_blank"
            rel="noopener noreferrer"
            class="footer-ver-pill tabular"
          >
            v{APP_VERSION}
          </a>
          <span class="footer-meta-note">MIT Licensed · Open Source</span>
        </div>
      </div>

      <nav class="footer-col" aria-label="Product">
        <h2 class="footer-col-title">Product</h2>
        <a href={`${homeHref}#views`}>App Views</a>
        <a href={`${homeHref}#suite`}>Study Suite</a>
        <a href={`${homeHref}#sources`}>Privacy &amp; Sources</a>
        <a href={`${homeHref}#android`}>Android Companion</a>
        <a href={`${homeHref}#faq`}>FAQ</a>
      </nav>

      <nav class="footer-col" aria-label="Platforms">
        <h2 class="footer-col-title">Platforms</h2>
        <a href={downloadHref}>Windows, macOS &amp; Linux</a>
        <a href={downloadHref}>Android APK</a>
        <a href={webAppHref}>Web Companion (PWA)</a>
        <a href={GITHUB_RELEASES_LATEST} target="_blank" rel="noopener noreferrer">GitHub Releases</a>
        <a href={CHECKSUMS_URL} target="_blank" rel="noopener noreferrer">SHA-256 Checksums</a>
      </nav>

      <nav class="footer-col" aria-label="Trust and Open Source">
        <h2 class="footer-col-title">Trust &amp; Legal</h2>
        <a href={privacyHref}>Privacy Policy</a>
        <a href={termsHref}>Terms of Service</a>
        <a href={GITHUB_REPO_URL} target="_blank" rel="noopener noreferrer">Source Code</a>
        <a
          href={`${GITHUB_REPO_URL}/blob/main/SECURITY.md`}
          target="_blank"
          rel="noopener noreferrer">Security Policy</a
        >
        <a
          href={`${GITHUB_REPO_URL}/blob/main/CHANGELOG.md`}
          target="_blank"
          rel="noopener noreferrer">Changelog</a
        >
      </nav>
    </div>
  </div>
</footer>

<style>
  .footer {
    margin-block-start: auto;
    border-block-start: 1px solid var(--surface-border);
    background-color: var(--page-subtle);
    padding-block: 56px max(40px, env(safe-area-inset-bottom));
  }

  .footer-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.55fr) repeat(3, minmax(0, 0.72fr));
    gap: 36px 40px;
    align-items: start;
  }

  .footer-brand-col {
    max-width: 400px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .footer-brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    width: fit-content;
  }

  .footer-brand :global(.footer-mark) {
    border-radius: 7px;
  }

  .footer-name {
    font-size: 1rem;
    font-weight: 720;
    letter-spacing: -0.02em;
    color: var(--text);
  }

  .footer-tagline {
    font-size: 0.855rem;
    line-height: 1.62;
    color: var(--text-muted);
    text-wrap: pretty;
  }

  .footer-release-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
    margin-block-start: 4px;
  }

  .footer-ver-pill {
    font-family: var(--font-mono);
    font-size: 0.74rem;
    font-weight: 600;
    padding: 3px 9px;
    border-radius: 999px;
    background-color: var(--surface);
    border: 1px solid var(--surface-border);
    color: var(--accent-ink);
    transition-property: border-color, color;
    transition-duration: 150ms;
    transition-timing-function: var(--ease-snappy);
  }

  .footer-meta-note {
    font-size: 0.78rem;
    color: var(--text-muted);
  }

  .footer-col {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .footer-col-title {
    font-family: var(--font-sans);
    font-size: 0.82rem;
    font-weight: 680;
    letter-spacing: -0.01em;
    color: var(--text);
    margin-block-end: 4px;
  }

  .footer-col a {
    display: inline-flex;
    align-items: center;
    padding-block: 4px;
    font-size: 0.85rem;
    color: var(--text-muted);
    width: fit-content;
    transition-property: color;
    transition-duration: 140ms;
    transition-timing-function: var(--ease-snappy);
  }

  @media (hover: hover) {
    .footer-col a:hover {
      color: var(--text);
      text-decoration: underline;
    }

    .footer-ver-pill:hover {
      border-color: var(--border-strong);
      color: var(--text);
    }
  }

  @media (max-width: 900px) {
    .footer-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .footer-brand-col {
      grid-column: 1 / -1;
      max-width: 520px;
    }
  }

  @media (max-width: 520px) {
    .footer-grid {
      grid-template-columns: minmax(0, 1fr);
      gap: 28px;
    }
  }
</style>
