{
  "name": "quizradar",
  "private": true,
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "prepare": "node tooling/install-hooks.mjs",
    "hooks:install": "node tooling/install-hooks.mjs",
    "agent:preflight": "node tooling/agent-preflight.mjs",
    "agent:note": "node tooling/agent-note.mjs",
    "agent:gate": "node tooling/agent-gate.mjs",
    "version:rollup": "node tooling/version-rollup.mjs --apply",
    "version:dry-run": "node tooling/version-rollup.mjs --dry-run",
    "lint": "eslint .",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "generate:version": "node tooling/generate-version.mjs",
    "generate:version:apply": "node tooling/generate-version.mjs --apply",
    "generate:version:check": "node tooling/generate-version.mjs --check",
    "generate:changelog": "node tooling/generate-changelog.mjs",
    "generate:updater": "node tooling/generate-updater-manifest.mjs",
    "core:test": "cargo test -p quizradar-core",
    "core:watch": "cargo watch -x test -p quizradar-core",
    "coverage:rust": "cargo llvm-cov --workspace --all-features --summary-only --json --output-path target/rust-coverage.json",
    "coverage:web": "pnpm --dir apps/web test:coverage",
    "coverage:ratchet": "node tooling/coverage-ratchet.mjs",
    "coverage:update": "node tooling/coverage-ratchet.mjs --update tooling/coverage-baseline.json",
    "landing:dev": "pnpm --filter @quizradar/landing dev",
    "landing:build": "pnpm --filter @quizradar/landing build",
    "site:build": "node tooling/build-site.mjs",
    "tauri:dev": "pnpm --dir apps/desktop dev",
    "tauri:build": "pnpm --dir apps/desktop build"
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "eslint": "^9.20.0",
    "eslint-config-prettier": "^10.0.0",
    "eslint-plugin-react": "^7.37.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.18",
    "globals": "^15.14.0",
    "prettier": "^3.4.0",
    "typescript-eslint": "^8.22.0"
  }
}
