---
import "@fontsource-variable/inter";
import "../styles/global.css";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import { APP_VERSION, FAQ_ITEMS, GITHUB_REPO_URL, withBase } from "../lib/releaseData";

interface Props {
  title?: string;
  description?: string;
  canonicalPath?: string;
  currentPage?: "home" | "download";
}

const {
  title = "QuizRadar — Local-First Exam Radar & Timetable Resolver",
  description = "Turn fuzzy course announcements from Gmail, Microsoft Teams, Moodle, and Google Classroom into exact exam countdowns, conflict alerts, and study plans. Free, MIT-licensed, zero servers.",
  canonicalPath = "/",
  currentPage = "home",
} = Astro.props;

const base = import.meta.env.BASE_URL;
const faviconSvg = withBase(base, "/favicon.svg");
const faviconIco = withBase(base, "/favicon.ico");
const faviconPng = withBase(base, "/favicon-32x32.png");
const appleTouch = withBase(base, "/apple-touch-icon.png");
const canonicalUrl = new URL(
  withBase(base, canonicalPath),
  Astro.site ?? "https://thedragonsoft.github.io",
).toString();
const ogImageUrl = new URL(
  withBase(base, "/og-image.png"),
  Astro.site ?? "https://thedragonsoft.github.io",
).toString();

const softwareSchema = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "QuizRadar",
  softwareVersion: APP_VERSION,
  applicationCategory: "EducationalApplication",
  operatingSystem: "Windows, macOS, Linux, Android, Web",
  license: "https://opensource.org/licenses/MIT",
  url: canonicalUrl,
  codeRepository: GITHUB_REPO_URL,
  offers: {
    "@type": "Offer",
    price: "0",
    priceCurrency: "USD",
  },
  description,
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: FAQ_ITEMS.map((item) => ({
    "@type": "Question",
    name: item.question,
    acceptedAnswer: {
      "@type": "Answer",
      text: item.answer,
    },
  })),
};
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0b0f19" id="meta-theme-color" />
    <link rel="canonical" href={canonicalUrl} />

    <!-- FOUC-free theme sync using the exact same `quizradar-theme` key as `/app/` -->
    <script is:inline>
      (function () {
        try {
          var saved = localStorage.getItem("quizradar-theme");
          var mode = saved === "light" || saved === "dark" ? saved : "dark";
          var root = document.documentElement;
          if (mode === "dark") {
            root.classList.add("dark");
          } else {
            root.classList.remove("dark");
          }
          var meta = document.getElementById("meta-theme-color");
          if (meta) meta.setAttribute("content", mode === "dark" ? "#0b0f19" : "#f8fafc");
        } catch (_e) {
          document.documentElement.classList.add("dark");
        }
      })();
    </script>

    <!-- Official QuizRadar calendar-radar squircle favicons -->
    <link rel="icon" type="image/svg+xml" href={faviconSvg} />
    <link rel="icon" type="image/png" sizes="32x32" href={faviconPng} />
    <link rel="shortcut icon" href={faviconIco} />
    <link rel="apple-touch-icon" sizes="256x256" href={appleTouch} />

    <!-- Open Graph / Twitter -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="QuizRadar" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="QuizRadar — Local-First Exam Radar & Timetable Resolver" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content="QuizRadar — Local-First Exam Radar & Timetable Resolver" />

    <script type="application/ld+json" set:html={JSON.stringify(softwareSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to main content</a>
    <Navbar currentPage={currentPage} />
    <main id="main-content" class="site-main">
      <slot />
    </main>
    <Footer />

    <!-- IntersectionObserver scroll-reveal (`animation-on-scroll`, reduced-motion safe) -->
    <script is:inline>
      (function () {
        var els = document.querySelectorAll(".animate-on-scroll");
        if (!els.length) return;
        if (
          !("IntersectionObserver" in window) ||
          window.matchMedia("(prefers-reduced-motion: reduce)").matches
        ) {
          els.forEach(function (el) {
            el.classList.add("is-visible");
          });
          return;
        }
        var io = new IntersectionObserver(
          function (entries) {
            entries.forEach(function (entry) {
              if (entry.isIntersecting) {
                entry.target.classList.add("is-visible");
                io.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.04, rootMargin: "0px 0px -20px 0px" },
        );
        els.forEach(function (el) {
          io.observe(el);
        });
      })();
    </script>
  </body>
</html>
