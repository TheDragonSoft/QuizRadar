# Rust
/target/
Cargo.lock.bak

# Node / web
node_modules/
dist/
dist-ssr/
.swc/

# Android / Kotlin (any gradle project)
.gradle/
build/
**/build/
local.properties
captures/
.cxx/
*.keystore
*.jks
key.properties

# IDE / OS
.idea/
.vscode/
*.iml
.DS_Store
Thumbs.db

# Generated by framework tools
apps/desktop/src-tauri/gen/

# Compiled WASM engine — built by tooling/build-wasm.mjs, never committed.
# The bridge in src/pwadapters/wasmBridge.ts imports it statically, so the
# build/test scripts regenerate it on demand.
apps/web/public/wasm/


# v5 runtime state — NEVER commit personal data or secrets
/data/
*.db
*.db-journal
*.sqlite
*.tmp

# Secrets & private material
.env
.env.*
token.json
microsoft_token.json
credentials.json
client_secret*.json
gemini_parsed_cache.json
quiz_emails_cache.json
processed_quizzes.json
*.pem
*.p12

# Scratch
/scratch/
*.log

# Local agent tooling (opencode skills) — stays untracked
.agents/
skills-lock.json

# Local agent scratch (reference dumps, helper scripts) — stays untracked
.zcode/
tooling/.screenshots/
tooling/screenshot.ps1
tooling/ui-click.ps1
# v4 reference dump (extracted from the `v4-final` tag for UI-parity work;
# the tag is the source of truth, the dump stays untracked)
tooling/.v4ref/

# Playwright artifacts (baselines in apps/web/e2e-baselines/ ARE committed)
apps/web/e2e-results/
apps/web/test-results/
playwright-report/
