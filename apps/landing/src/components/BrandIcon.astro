    | "quizradar"
    | "gmail"
    | "teams"
    | "moodle"
    | "classroom"
    | "gcal"
    | "drive"
    | "windows"
    | "apple"
    | "linux"
    | "android"
    | "github"
    | "check"
    | "arrow-up-right"
    | "download"
    | "globe"
    | "shield"
    | "cpu"
    | "calendar"
    | "sparkles"
    | "copy"
    | "sun"
    | "moon"
    | "zap"
    | "chevron-down"
    | "menu"
    | "x";
  size?: number;
  animated?: boolean;
  class?: string;
