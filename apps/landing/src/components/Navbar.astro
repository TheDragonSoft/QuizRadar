---
import BrandIcon from "./BrandIcon.astro";
import { GITHUB_REPO_URL, withBase } from "../lib/releaseData";

interface Props {
  currentPage?: "home" | "download" | "privacy" | "terms";
}

const { currentPage = "home" } = Astro.props;
const base = import.meta.env.BASE_URL;
const homeHref = withBase(base, "/");
const downloadHref = withBase(base, "/download/");
const webAppHref = withBase(base, "/app/");
const isHeroOverlay = currentPage === "home" || currentPage === "download";
---

<header class:list={["nav", { "nav-over-sky": isHeroOverlay }]} id="site-nav">
  <div class="nav-inner">
    <a href={homeHref} class="nav-brand" aria-label="QuizRadar home">
      <BrandIcon name="quizradar" size={30} animated={true} uid="nav" class="nav-logo" />
      <span class="nav-wordmark">QuizRadar</span>
    </a>

    <!-- Focused 4-item navigation with scroll-spy on home -->
    <nav class="nav-links nav-desktop-only" aria-label="Primary">
      <a href={`${homeHref}#views`} class="nav-link" data-nav-section="views">App Views</a>
      <a href={`${homeHref}#suite`} class="nav-link" data-nav-section="suite">Study Suite</a>
      <a href={`${homeHref}#sources`} class="nav-link" data-nav-section="sources"
        >Privacy &amp; Sources</a
      >
      <a href={`${homeHref}#android`} class="nav-link" data-nav-section="android">Android</a>
    </nav>

    <div class="nav-actions">
      <!-- 3-Theme Student Observatory Switcher (Desktop & Tablet) -->
      <div class="theme-switcher nav-theme-desktop" role="group" aria-label="Observatory theme">
        <button
          type="button"
          class="theme-opt is-active"
          data-set-theme="obsidian"
          aria-pressed="true"
          aria-label="Obsidian dark theme"
          title="Obsidian Cosmic (Dark)"
        >
          <BrandIcon name="moon" size={14} />
          <span class="theme-opt-text">Obsidian</span>
        </button>
        <button
          type="button"
          class="theme-opt"
          data-set-theme="solar"
          aria-pressed="false"
          aria-label="Solar light theme"
          title="Solar Dawn (Light)"
        >
          <BrandIcon name="sun" size={14} />
          <span class="theme-opt-text">Solar</span>
        </button>
        <button
          type="button"
          class="theme-opt"
          data-set-theme="amoled-nebula"
          aria-pressed="false"
          aria-label="AMOLED black theme"
          title="AMOLED Cosmic Stardust"
        >
          <BrandIcon name="eclipse" size={14} />
          <span class="theme-opt-text">AMOLED</span>
        </button>
      </div>

      <!-- Mobile 44x44 single-tap theme cycle button -->
      <button
        type="button"
        class="nav-icon-btn nav-theme-cycle-btn"
        data-cycle-theme
        aria-label="Cycle Observatory theme (Obsidian, Solar, AMOLED)"
        title="Switch Observatory theme"
      >
        <BrandIcon name="sun" size={18} />
      </button>

      <!-- GitHub Source Link -->
      <a
        href={GITHUB_REPO_URL}
        target="_blank"
        rel="noopener noreferrer"
        class="nav-icon-btn nav-hide-mobile"
        aria-label="QuizRadar source code on GitHub"
        title="Inspect MIT source on GitHub"
      >
        <BrandIcon name="github" size={17} />
      </a>

      <!-- Consistent Primary CTA across desktop and mobile -->
      <a
        href={downloadHref}
        class:list={["btn btn-primary nav-dl-btn", { "is-current": currentPage === "download" }]}
        aria-current={currentPage === "download" ? "page" : undefined}
      >
        <BrandIcon name="download" size={15} />
        <span>Download</span>
      </a>

      <!-- Mobile Hamburger Toggle (44x44 touch target) -->
      <button
        type="button"
        class="nav-icon-btn nav-hamburger-btn"
        id="nav-menu-toggle"
        aria-expanded="false"
        aria-controls="nav-mobile-menu"
        aria-label="Toggle navigation menu"
      >
        <span class="icon-menu">
          <BrandIcon name="menu" size={19} />
        </span>
        <span class="icon-close">
          <BrandIcon name="x" size={19} />
        </span>
      </button>
    </div>
  </div>

  <!-- Mobile Collapsible Drawer -->
  <div class="nav-mobile-drawer" id="nav-mobile-menu" hidden>
    <div class="nav-mobile-inner">
      <div class="mobile-theme-group" role="group" aria-label="Observatory theme">
        <button
          type="button"
          class="theme-opt is-active"
          data-set-theme="obsidian"
          aria-pressed="true"
          aria-label="Obsidian dark theme"
        >
          <BrandIcon name="moon" size={15} />
          <span>Obsidian</span>
        </button>
        <button
          type="button"
          class="theme-opt"
          data-set-theme="solar"
          aria-pressed="false"
          aria-label="Solar light theme"
        >
          <BrandIcon name="sun" size={15} />
          <span>Solar</span>
        </button>
        <button
          type="button"
          class="theme-opt"
          data-set-theme="amoled-nebula"
          aria-pressed="false"
          aria-label="AMOLED black theme"
        >
          <BrandIcon name="eclipse" size={15} />
          <span>AMOLED</span>
        </button>
      </div>

      <nav class="nav-mobile-links" aria-label="Mobile navigation">
        <a href={`${homeHref}#views`} class="mobile-nav-link">
          <span>App Views</span>
          <span class="mobile-nav-desc">Dashboard, Week Calendar, Roadmap, GPA, Flashcards</span>
        </a>
        <a href={`${homeHref}#suite`} class="mobile-nav-link">
          <span>Study Suite</span>
          <span class="mobile-nav-desc">Study Cushion, Week A/B parity, print cram sheets</span>
        </a>
        <a href={`${homeHref}#sources`} class="mobile-nav-link">
          <span>Privacy &amp; Sources</span>
          <span class="mobile-nav-desc">Zero-server flow across Gmail, Teams, Moodle &amp; Canvas</span>
        </a>
        <a href={`${homeHref}#android`} class="mobile-nav-link">
          <span>Android App</span>
          <span class="mobile-nav-desc">4×2 &amp; 2×1 Glance widgets, attendance &amp; LAN QR sync</span>
        </a>
        <a href={`${homeHref}#faq`} class="mobile-nav-link">
          <span>FAQ</span>
          <span class="mobile-nav-desc">Privacy guarantees, offline core &amp; device sync</span>
        </a>
      </nav>

      <div class="nav-mobile-footer">
        <a href={downloadHref} class="btn btn-primary mobile-menu-cta">
          <BrandIcon name="download" size={16} />
          <span>Download Installers</span>
        </a>
        <a href={webAppHref} class="btn btn-secondary mobile-menu-cta">
          <BrandIcon name="globe" size={16} />
          <span>Try Web App in Browser</span>
        </a>
        <a
          href={GITHUB_REPO_URL}
          target="_blank"
          rel="noopener noreferrer"
          class="mobile-github-link"
        >
          <BrandIcon name="github" size={15} />
          <span>View MIT Source on GitHub</span>
        </a>
      </div>
    </div>
  </div>
</header>

<script>
  type ObservatoryTheme = "obsidian" | "solar" | "amoled-nebula";
  const THEME_ORDER: ObservatoryTheme[] = ["obsidian", "solar", "amoled-nebula"];

  const nav = document.getElementById("site-nav");
  const menuToggle = document.getElementById("nav-menu-toggle");
  const mobileMenu = document.getElementById("nav-mobile-menu");

  const syncScrollState = () => {
    if (!nav) return;
    nav.classList.toggle("is-scrolled", window.scrollY > 18);
  };
  window.addEventListener("scroll", syncScrollState, { passive: true });
  syncScrollState();

  const currentTheme = (): ObservatoryTheme => {
    const t = document.documentElement.dataset.theme;
    if (t === "solar" || t === "amoled-nebula") return t;
    return "obsidian";
  };

  const syncThemeImages = async (active: ObservatoryTheme) => {
    const imgs = Array.from(document.querySelectorAll<HTMLImageElement>("img[data-theme-img]"));
    const decodes: Promise<unknown>[] = [];
    imgs.forEach((img) => {
      const nextSrc =
        active === "solar"
          ? img.dataset.srcLight
          : active === "amoled-nebula"
            ? img.dataset.srcAmoled
            : img.dataset.srcDark;
      if (nextSrc && img.getAttribute("src") !== nextSrc) {
        img.setAttribute("src", nextSrc);
        if (typeof img.decode === "function" && !img.closest("[hidden]")) {
          decodes.push(img.decode().catch(() => undefined));
        }
      }
    });
    if (decodes.length > 0) {
      await Promise.all(decodes);
    }
  };

  const syncThemeButtons = (active: ObservatoryTheme) => {
    document.querySelectorAll<HTMLButtonElement>("[data-set-theme]").forEach((btn) => {
      const selected = btn.dataset.setTheme === active;
      btn.setAttribute("aria-pressed", selected ? "true" : "false");
      btn.classList.toggle("is-active", selected);
    });
  };

  const applyTheme = async (next: ObservatoryTheme, useTransition = false) => {
    await syncThemeImages(next);

    const mutateDom = () => {
      const root = document.documentElement;
      root.dataset.theme = next;
      root.classList.toggle("dark", next !== "solar");
      try {
        localStorage.setItem("quizradar-theme", next);
        localStorage.setItem("quizradar_theme", next);
      } catch {
        // Ignore storage errors in private browsing
      }
      const meta = document.getElementById("meta-theme-color");
      if (meta) {
        meta.setAttribute(
          "content",
          next === "solar" ? "#f5f7fb" : next === "amoled-nebula" ? "#000000" : "#070a12",
        );
      }
      syncThemeButtons(next);
    };

    const docWithVT = document as Document & {
      startViewTransition?: (cb: () => void) => unknown;
    };
    const allowMotion = window.matchMedia("(prefers-reduced-motion: no-preference)").matches;
    if (useTransition && allowMotion && typeof docWithVT.startViewTransition === "function") {
      docWithVT.startViewTransition(mutateDom);
    } else {
      mutateDom();
    }
  };

  // Initial sync for buttons and theme-aware images
  const initTheme = currentTheme();
  syncThemeButtons(initTheme);
  void syncThemeImages(initTheme);

  // Delegate clicks for all `[data-set-theme]` buttons (Navbar, Mobile Drawer, and `#views` stage bar)
  document.addEventListener("click", (event) => {
    const targetEl = (event.target as Element | null)?.closest<HTMLButtonElement>("[data-set-theme]");
    if (targetEl) {
      const target = targetEl.dataset.setTheme as ObservatoryTheme | undefined;
      if (target && target !== currentTheme()) {
        void applyTheme(target, true);
      }
      return;
    }

    const cycleEl = (event.target as Element | null)?.closest<HTMLButtonElement>("[data-cycle-theme]");
    if (cycleEl) {
      const cur = currentTheme();
      const next = THEME_ORDER[(THEME_ORDER.indexOf(cur) + 1) % THEME_ORDER.length];
      void applyTheme(next, true);
    }
  });

  // Active section scroll-spy for desktop links
  const sectionLinks = Array.from(document.querySelectorAll<HTMLAnchorElement>("[data-nav-section]"));
  const sections = sectionLinks
    .map((link) => {
      const id = link.dataset.navSection;
      const el = id ? document.getElementById(id) : null;
      return el ? { id, el, link } : null;
    })
    .filter((item): item is { id: string; el: HTMLElement; link: HTMLAnchorElement } => item !== null);

  if (sections.length > 0 && "IntersectionObserver" in window) {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            const activeId = entry.target.id;
            sections.forEach((s) => s.link.classList.toggle("is-active", s.id === activeId));
          }
        });
      },
      { rootMargin: "-30% 0px -55% 0px", threshold: 0.01 },
    );
    sections.forEach((s) => observer.observe(s.el));
  }

  // Mobile Menu Drawer
  if (menuToggle && mobileMenu) {
    const closeMenu = () => {
      menuToggle.setAttribute("aria-expanded", "false");
      mobileMenu.classList.remove("is-open");
      mobileMenu.hidden = true;
    };

    const openMenu = () => {
      menuToggle.setAttribute("aria-expanded", "true");
      mobileMenu.hidden = false;
      requestAnimationFrame(() => mobileMenu.classList.add("is-open"));
    };

    menuToggle.addEventListener("click", () => {
      const expanded = menuToggle.getAttribute("aria-expanded") === "true";
      if (expanded) closeMenu();
      else openMenu();
    });

    mobileMenu.querySelectorAll("a").forEach((link) => link.addEventListener("click", closeMenu));

    window.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && menuToggle.getAttribute("aria-expanded") === "true") {
        closeMenu();
        menuToggle.focus();
      }
    });
  }
</script>

<style>
  .nav {
    position: sticky;
    inset-block-start: 0;
    z-index: 50;
    background-color: var(--nav-bg);
    -webkit-backdrop-filter: blur(16px);
    backdrop-filter: blur(16px);
    border-block-end: 1px solid transparent;
    transition-property: border-color, background-color, box-shadow;
    transition-duration: 180ms;
    transition-timing-function: var(--ease-snappy);
  }

  /* Blend smoothly over the full-bleed sky canopy before scrolling */
  .nav.nav-over-sky:not(.is-scrolled) {
    background-color: var(--nav-bg-over-sky);
    border-block-end-color: rgba(255, 255, 255, 0.12);
  }

  .nav.nav-over-sky:not(.is-scrolled) .nav-wordmark {
    color: #ffffff;
  }

  .nav.nav-over-sky:not(.is-scrolled) .nav-link {
    color: rgba(241, 245, 249, 0.88);
  }

  .nav.nav-over-sky:not(.is-scrolled) .nav-link.is-active {
    color: #ffffff;
    background-color: rgba(255, 255, 255, 0.16);
  }

  .nav.nav-over-sky:not(.is-scrolled) .theme-switcher,
  .nav.nav-over-sky:not(.is-scrolled) .nav-icon-btn {
    background-color: rgba(7, 10, 18, 0.42);
    border-color: rgba(255, 255, 255, 0.22);
    color: rgba(241, 245, 249, 0.92);
  }

  .nav.nav-over-sky:not(.is-scrolled) .theme-opt {
    color: rgba(226, 232, 240, 0.88);
  }

  .nav.nav-over-sky:not(.is-scrolled) .theme-opt.is-active {
    background-color: #fbbf24;
    color: #090d16;
  }

  /* High-contrast Download CTA over both Solar & Dark skies (11.4:1 contrast) */
  .nav.nav-over-sky:not(.is-scrolled) .nav-dl-btn {
    background-color: #ffffff;
    color: #0e2458;
    border-color: rgba(255, 255, 255, 0.9);
  }

  .nav.is-scrolled {
    border-block-end-color: var(--surface-border);
    box-shadow: var(--shadow-sm);
  }

  .nav-inner {
    max-width: 1240px;
    margin-inline: auto;
    padding: 10px 28px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
  }

  .nav-brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-height: 40px;
    flex-shrink: 0;
  }

  .nav-brand :global(.nav-logo) {
    border-radius: 7px;
  }

  .nav-wordmark {
    font-size: 1.04rem;
    font-weight: 720;
    letter-spacing: -0.025em;
    color: var(--text);
  }

  .nav-links {
    display: inline-flex;
    align-items: center;
    gap: 4px;
  }

  .nav-link {
    font-size: 0.84rem;
    font-weight: 560;
    color: var(--text-muted);
    padding: 7px 12px;
    border-radius: 9px;
    white-space: nowrap;
    transition-property: color, background-color;
    transition-duration: 150ms;
    transition-timing-function: var(--ease-snappy);
  }

  .nav-link.is-active {
    color: var(--text);
    background-color: var(--accent-soft);
  }

  .nav-actions {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-shrink: 0;
  }

  /* 3-Theme Observatory Pill */
  .theme-switcher {
    display: inline-flex;
    align-items: center;
    gap: 2px;
    padding: 3px;
    border-radius: 10px;
    background-color: var(--surface-elevated);
    border: 1px solid var(--surface-border);
  }

  .theme-opt {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 5px;
    min-height: 32px;
    padding: 0 10px;
    border-radius: 7px;
    font-size: 0.76rem;
    font-weight: 620;
    color: var(--text-muted);
    white-space: nowrap;
    transition-property: transform, background-color, color;
    transition-duration: 140ms;
    transition-timing-function: var(--ease-snappy);
  }

  .theme-opt:active {
    transform: scale(0.96);
  }

  .theme-opt.is-active {
    background-color: var(--accent-fill);
    color: #ffffff;
  }

  .nav-icon-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    border-radius: 10px;
    background-color: var(--surface-elevated);
    border: 1px solid var(--surface-border);
    color: var(--text-muted);
    transition-property: transform, color, background-color, border-color;
    transition-duration: 150ms;
    transition-timing-function: var(--ease-snappy);
  }

  .nav-icon-btn:active {
    transform: scale(0.96);
  }

  .nav-theme-cycle-btn {
    display: none;
  }

  .nav-dl-btn {
    min-height: 38px;
    padding: 7px 14px;
    border-radius: 10px;
    font-size: 0.83rem;
  }

  .nav-dl-btn.is-current {
    box-shadow: 0 0 0 2px #fbbf24;
  }

  .nav-hamburger-btn {
    display: none;
  }

  .nav-hamburger-btn .icon-close {
    display: none;
  }

  .nav-hamburger-btn[aria-expanded="true"] .icon-menu {
    display: none;
  }

  .nav-hamburger-btn[aria-expanded="true"] .icon-close {
    display: inline-flex;
  }

  /* Mobile Drawer */
  .nav-mobile-drawer {
    border-block-start: 1px solid var(--surface-border);
    background-color: var(--surface);
    box-shadow: var(--shadow-lg);
    max-height: calc(100dvh - 60px);
    overflow-y: auto;
    opacity: 0;
    transform: translateY(-6px);
    transition-property: opacity, transform;
    transition-duration: 180ms;
    transition-timing-function: var(--ease-snappy);
  }

  .nav-mobile-drawer.is-open {
    opacity: 1;
    transform: translateY(0);
  }

  .nav-mobile-inner {
    padding: 16px 20px 24px;
    display: flex;
    flex-direction: column;
    gap: 14px;
    max-width: 520px;
    margin-inline: auto;
  }

  .mobile-theme-group {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 6px;
    padding: 4px;
    border-radius: 12px;
    background-color: var(--surface-elevated);
    border: 1px solid var(--surface-border);
  }

  .mobile-theme-group .theme-opt {
    min-height: 44px;
    font-size: 0.82rem;
    border-radius: 9px;
  }

  .nav-mobile-links {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .mobile-nav-link {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: 11px 14px;
    min-height: 48px;
    border-radius: 11px;
    transition-property: background-color, transform;
    transition-duration: 150ms;
    transition-timing-function: var(--ease-snappy);
  }

  .mobile-nav-link:active {
    transform: scale(0.98);
  }

  .mobile-nav-link span:first-child {
    font-size: 0.94rem;
    font-weight: 650;
    color: var(--text);
  }

  .mobile-nav-desc {
    font-size: 0.78rem;
    color: var(--text-muted);
  }

  .nav-mobile-footer {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding-block-start: 12px;
    border-block-start: 1px solid var(--surface-border);
  }

  .mobile-menu-cta {
    width: 100%;
    justify-content: center;
    min-height: 44px;
    font-size: 0.88rem;
  }

  .mobile-github-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 7px;
    min-height: 44px;
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--text-muted);
  }

  @media (hover: hover) {
    .nav-link:hover {
      color: var(--text);
      background-color: var(--surface-hover);
    }

    .nav.nav-over-sky:not(.is-scrolled) .nav-link:hover {
      color: #ffffff;
      background-color: rgba(255, 255, 255, 0.14);
    }

    .theme-opt:not(.is-active):hover {
      color: var(--text);
    }

    .nav.nav-over-sky:not(.is-scrolled) .theme-opt:not(.is-active):hover {
      color: #ffffff;
    }

    .nav.nav-over-sky:not(.is-scrolled) .nav-dl-btn:hover {
      background-color: #edf4ff;
    }

    .nav-icon-btn:hover {
      color: var(--text);
      background-color: var(--surface-hover);
      border-color: var(--border-strong);
    }

    .nav.nav-over-sky:not(.is-scrolled) .nav-icon-btn:hover {
      color: #ffffff;
      background-color: rgba(255, 255, 255, 0.16);
      border-color: rgba(255, 255, 255, 0.34);
    }

    .mobile-nav-link:hover {
      background-color: var(--surface-hover);
    }
  }

  @media (max-width: 1080px) {
    .nav-theme-desktop .theme-opt-text {
      display: none;
    }

    .nav-theme-desktop .theme-opt {
      padding: 0 9px;
      min-width: 34px;
    }
  }

  @media (max-width: 860px) {
    .nav-desktop-only,
    .nav-hide-mobile,
    .nav-theme-desktop {
      display: none !important;
    }

    .nav-theme-cycle-btn,
    .nav-hamburger-btn {
      display: inline-flex;
      width: 44px;
      height: 44px;
    }

    .nav-dl-btn {
      min-height: 44px;
      padding: 8px 14px;
    }

    .nav-inner {
      padding-inline: 16px;
    }
  }

  @media (max-width: 420px) {
    .nav-inner {
      padding-inline: 12px;
      gap: 6px;
    }

    .nav-wordmark {
      font-size: 0.95rem;
    }

    .nav-actions {
      gap: 6px;
    }

    .nav-dl-btn {
      padding: 8px 11px;
      font-size: 0.78rem;
    }
  }
</style>
