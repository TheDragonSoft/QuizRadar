<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Requested at runtime only when the tester explicitly starts a voice note. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <queries>
        <!-- Optional dictation in Beta Feedback via the device's configured speech-to-text service. -->
        <intent>
            <action android:name="android.speech.action.RECOGNIZE_SPEECH" />
        </intent>
    </queries>

    <application
        android:label="QuizRadar"
        android:icon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:usesCleartextTraffic="false"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:enableOnBackInvokedCallback="true"
        android:theme="@style/Theme.QuizRadar">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Custom-scheme PKCE OAuth redirect with authority (com.quizradar.app://oauth/...) -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="com.quizradar.app"
                    android:host="oauth" />
            </intent-filter>

            <!-- Custom-scheme PKCE OAuth redirect without authority (com.quizradar.app:/oauth/...) -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="com.quizradar.app"
                    android:pathPrefix="/oauth" />
            </intent-filter>

            <!-- Share-sheet ingest for announcement text / emails -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>

            <!-- App Shortcuts & Serverless Peer Sync Deep Links -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="quizradar"
                    android:host="action" />
                <data
                    android:scheme="quizradar"
                    android:host="pair" />
                <data
                    android:scheme="quizradar"
                    android:host="lan" />
            </intent-filter>

            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <!-- 2x1 Glance Countdown Widget -->
        <receiver
            android:name=".glance.QuizRadarWidgetReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/quizradar_widget_info" />
        </receiver>

        <!-- 4x2 / 4x1 Glance Today's Schedule Widget -->
        <receiver
            android:name=".glance.TodayScheduleWidgetReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/today_schedule_widget_info" />
        </receiver>

        <!-- Read-only, temporary beta-feedback ZIP sharing. The authority exposes
             only cache/beta-feedback/packages via feedback_paths.xml, never drafts or app data. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.feedback"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/feedback_paths" />
        </provider>

    </application>

</manifest>
