<?xml version="1.0" encoding="utf-8"?>
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="add_event"
        android:enabled="true"
        android:icon="@mipmap/ic_launcher"
        android:shortcutShortLabel="@string/shortcut_add_event_short"
        android:shortcutLongLabel="@string/shortcut_add_event_long">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="com.quizradar.app"
            android:targetClass="com.quizradar.app.MainActivity"
            android:data="quizradar://action/add_event" />
    </shortcut>
    <shortcut
        android:shortcutId="start_focus"
        android:enabled="true"
        android:icon="@mipmap/ic_launcher"
        android:shortcutShortLabel="@string/shortcut_focus_short"
        android:shortcutLongLabel="@string/shortcut_focus_long">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="com.quizradar.app"
            android:targetClass="com.quizradar.app.MainActivity"
            android:data="quizradar://action/focus" />
    </shortcut>
</shortcuts>
