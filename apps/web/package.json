{
  "name": "@quizradar/web",
  "version": "5.11.2",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "ladle": "ladle serve",
    "build:sw": "node ../../tooling/build-sw.mjs",
    "build:wasm": "node ../../tooling/build-wasm.mjs",
    "build": "node ../../tooling/build-wasm.mjs && node ../../tooling/build-sw.mjs && tsc --noEmit -p tsconfig.json && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:full": "node ../../tooling/build-wasm.mjs && node ../../tooling/build-sw.mjs && vitest run",
    "e2e": "playwright test",
    "e2e:showcase": "playwright test --config playwright.showcase.config.ts",
    "e2e:update": "playwright test --update-snapshots",
    "e2e:authed": "node e2e/authed/run-authed-sweep.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.2.0",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-opener": "^2.5.0",
    "lucide-react": "^1.61.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@ladle/react": "5.1.1",
    "@playwright/test": "^1.64.1",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.2.0",
    "@types/jest-axe": "^3.5.9",
    "@types/node": "^26.6.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^3.0.0",
    "autoprefixer": "^10.4.20",
    "axe-core": "^4.14.0",
    "jest-axe": "^11.0.0",
    "jsdom": "^25.0.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  }
}
